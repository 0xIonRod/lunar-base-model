{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lunar base simulation news record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "content_sha256", "title", "published_at", "retrieved_at", "event_date", "supersedes", "source", "summary", "reported_facts", "topics", "simulation_actions", "review"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^lunar-[a-f0-9]{16}$"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{12}$"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "title": {"$ref": "#/$defs/text"},
    "published_at": {"type": "string", "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "event_date": {"type": ["string", "null"], "format": "date"},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^lunar-[a-f0-9]{16}-[a-f0-9]{12}\\.json$"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "url", "feed_url", "type", "evidence_scope"],
      "properties": {
        "name": {"$ref": "#/$defs/text"}, "url": {"$ref": "#/$defs/url"},
        "feed_url": {"anyOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
        "type": {"enum": ["primary", "secondary"]},
        "evidence_scope": {"enum": ["feed_excerpt", "full_article", "technical_document"]}
      }
    },
    "summary": {"$ref": "#/$defs/text"},
    "reported_facts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["statement", "source_url", "locator", "evidence_excerpt"],
        "properties": {
          "statement": {"$ref": "#/$defs/text"}, "source_url": {"$ref": "#/$defs/url"},
          "locator": {"$ref": "#/$defs/text"}, "evidence_excerpt": {"type": "string"}
        }
      }
    },
    "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["power", "mobility", "communications", "resources_and_construction", "mission_and_delivery"]}},
    "simulation_actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "status", "rationale", "next_step", "affected_paths", "missing_inputs", "acceptance_criteria", "parameters"],
        "properties": {
          "kind": {"enum": ["research", "propose_scenario", "propose_parameter_change"]},
          "status": {"enum": ["proposed", "accepted", "rejected", "completed"]},
          "rationale": {"$ref": "#/$defs/text"}, "next_step": {"$ref": "#/$defs/text"},
          "affected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
          "missing_inputs": {"type": "array", "items": {"$ref": "#/$defs/text"}},
          "acceptance_criteria": {"$ref": "#/$defs/text"},
          "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}
        }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "notes"],
      "properties": {
        "status": {"enum": ["candidate", "verified", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"$ref": "#/$defs/text"}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value", "unit", "source_url", "locator", "uncertainty", "basis"],
      "properties": {
        "name": {"$ref": "#/$defs/text"}, "value": {"type": ["number", "null"]},
        "unit": {"$ref": "#/$defs/text"}, "source_url": {"$ref": "#/$defs/url"},
        "locator": {"$ref": "#/$defs/text"}, "uncertainty": {"$ref": "#/$defs/text"},
        "basis": {"enum": ["measured", "planned", "assumed", "unknown"]}
      }
    }
  }
}
