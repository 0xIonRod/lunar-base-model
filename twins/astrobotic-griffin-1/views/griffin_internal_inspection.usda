#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
    doc = "Griffin internal inspection. Four geometric tank stations share two modeled propellant inventories. Interior dimensions and species assignments are simulation assumptions."
)

def Xform "World"
{
    def Xform "Griffin" (
        prepend references = @twin://astrobotic-griffin-1/vehicles/griffin_1.usda@</Griffin1>
    )
    {
        over "SolarPanelForward"
        {
            token visibility = "invisible"
        }
        over "SolarPanelFrontStarboard"
        {
            token visibility = "invisible"
        }
        over "SolarPanelFrontPort"
        {
            token visibility = "invisible"
        }
        over "Bus"
        {
            over "TankSupportPlate"
            {
                over "ExteriorBlankets"
                {
                    token visibility = "invisible"
                }
            }
            over "TopDeckOctagon"
            {
                token visibility = "invisible"
            }
            over "LowerServiceSkirtOctagon"
            {
                token visibility = "invisible"
            }
            over "UpperCentralBucket"
            {
                token visibility = "invisible"
            }
            over "LowerCentralBucket"
            {
                token visibility = "invisible"
            }
            over "RoverPayloadDeck"
            {
                token visibility = "invisible"
            }
            over "UpperPressurantVisuals"
            {
                token visibility = "invisible"
            }
        }
        over "PayloadAdapter"
        {
            token visibility = "invisible"
        }
        over "Nozzle"
        {
            over "MainEngineCluster"
            {
                over "EngineSkirt"
                {
                    token visibility = "invisible"
                }
            }
        }
    }
}
