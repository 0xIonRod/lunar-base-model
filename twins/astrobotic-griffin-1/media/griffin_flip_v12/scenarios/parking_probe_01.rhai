const R="/Griffin1SurfaceOps/FLIP";
fn simulation_dependencies(me,ctx) {#{modelica_entities:[find_path(R)],entity_reads:[find_path(R),find_path("/Griffin1SurfaceOps/FlipRoute/P3")],entity_writes:[find_path(R)],query_reads:[],required_inputs:[]}}
fn on_start(me,ctx) {this.n=0;this.done=false;this.started=clock_snapshot().world_sim_s;this.goal=world_pos(find_path("/Griffin1SurfaceOps/FlipRoute/P3"));let r=modelica_waypoint(find_path(R),this.goal,0.10,0.25,0.0);if !r.ok {throw r.to_string();}cmd("SetTimeTransport",#{playing:true,rate:1.0});cmd("StepSimulation",#{hold:false});}
fn on_tick(me,ctx) {if this.done {return;}let r=find_path(R);let p=world_pos(r);let dx=p[0]-this.goal[0];let dz=p[2]-this.goal[2];let d=sqrt(dx*dx+dz*dz);this.n+=1;if this.n%30==0 {print("PARK_PROBE|"+d+"|"+port(r,"program_active")+"|"+port(r,"autopilot_enable")+"|"+p);}if d<0.35 || clock_snapshot().world_sim_s-this.started>20.0 {modelica_waypoint_stop(r);this.done=true;report_verdict([t_true(d<0.35,"fresh final approach reaches the real destination")],"PARK HANDOFF","PARK_HANDOFF");cmd("StepSimulation",#{hold:true});}}
