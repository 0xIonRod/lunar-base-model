#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
}

def Xform "Griffin1SurfaceOps" (
    prepend references = @twin://astrobotic-griffin-1/tests/flip_route_follow.usda@</Griffin1SurfaceOps>
)
{
    over "Scenario"
    {
        def "Test" (
            active = true
        )
        {
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/media/griffin_flip_v12/scenarios/routes_01.rhai@
        }
    }
    over "Avatar"
    {
        custom double3 xformOp:translate = (-16.46215333887149, 49.230282748857086, -39.63182421474647)
        double3 lunco:cameraLookAt = (-7.9558111948738635, -0.7697172511429119, -12.288778602941452)
        custom double3 xformOp:rotateXYZ = (-90.0, 0.0, 0.0)
        float focalLength = 24.0
    }
    def Scope "Policies"
    {
    }
    def LunCoPolicy "FilmViews"
    {
        uniform string lunco:policy:seam = "workbench.perspectives.twin"
        string lunco:policy:entry = "assemble"
        uniform string info:sourceCode = "fn assemble(facts) { [#{id:\"film-drive\",title:\"Driving energy\",description:\"Four native motion and power histories with the rover centered above them.\",interaction:\"editor\",restore:false,scene_visible:true,floating:[#{kind:\"signal_grid\",instance:1,corner:\"bottom_left\",width:2500,height:420,inset:20}]},#{id:\"film-model\",title:\"Power and control\",description:\"Actual exported Modelica components, electrical connections and control bindings.\",interaction:\"editor\",restore:false,instances:[#{kind:\"modelica_model_view\",instance:3,slot:\"center\"}]}] }"
        bool lunco:policy:deterministic = false
    }
    def LunCoPolicy "FilmRecordingUI"
    {
        uniform string lunco:policy:seam = "runtime.ui.recording"
        string lunco:policy:entry = "select"
        uniform string info:sourceCode = "fn select(facts) {let ids=[];for id in facts.visible_surface_ids {if id.starts_with(\"energy-\") {ids.push(id);}}ids}"
        bool lunco:policy:deterministic = false
    }
    def Scope "DriveStimulus"
    {
    }
    def Xform "DriveProgramHost"
    {
    }
    def Scope "AmberRoute"
    {
        custom color3f[] primvars:displayColor = [(1.0, 0.44999998807907104, 0.029999999329447746)]
        def Scope "Program" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/route_follow.rhai@
            custom float inputs:enabled = 0.0
            custom rel inputs:subject = </Griffin1SurfaceOps/FLIP_Amber>
            custom double inputs:cruise_throttle = 0.1
            custom double inputs:arrival_radius = 0.4
        }
        def Xform "P0" (
            references = @lunco://markers/route_point.usda@
            active = true
        )
        {
            custom double3 xformOp:translate = (0.0, 0.21062861382961273, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            bool lunco:billboard = false
            custom color3f[] primvars:displayColor = [(0.8999999761581421, 0.8999999761581421, 0.8999999761581421)]
            custom double inputs:drive_direction = 1.0
            over "Trigger"
            {
                token lunco:triggerZone = "AmberRoute_P0"
                double radius = 0.4
            }
            over "Dome"
            {
                double radius = 0.35
                double3 xformOp:translate = (0.0, 0.35, 0.0)
            }
        }
