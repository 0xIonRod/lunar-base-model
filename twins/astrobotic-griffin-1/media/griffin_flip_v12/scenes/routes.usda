        def Scope "ContactMaterials"
        {
            def Material "RegolithTread" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            )
            {
                float physics:staticFriction = 0.6000000238418579
                float physics:dynamicFriction = 0.6000000238418579
                float physics:restitution = 0.0
                custom token physxMaterial:frictionCombineMode = "min"
                custom string documentation = "Native rigid wheel/soil contact, nominal mu 0.6. An estimated Coulomb approximation; wheel deformation and soil sinkage are not resolved. The separate tire slip-force layer is excluded by native material ownership."
            }
        }
        over "Thermal" (
            active = false
        )
        {
        }
        over Scope "Drivetrain"
        {
            custom double parameters:steer_gain = 1.0
        }
    }
    def Scope "ComparisonGroups"
    {
        def PhysicsCollisionGroup "Blue"
        {
            rel collection:colliders:includes = </Griffin1SurfaceOps/FLIP>
            rel physics:filteredGroups = </Griffin1SurfaceOps/ComparisonGroups/Amber>
            uniform token collection:colliders:expansionRule = "expandPrims"
        }
        def PhysicsCollisionGroup "Amber"
        {
            rel collection:colliders:includes = </Griffin1SurfaceOps/FLIP_Amber>
            rel physics:filteredGroups = </Griffin1SurfaceOps/ComparisonGroups/Blue>
            uniform token collection:colliders:expansionRule = "expandPrims"
        }
    }
    def LunCoPolicy "MissionEnergyProperties"
    {
        uniform string lunco:policy:seam = "runtime.ui.properties"
        string lunco:policy:entry = "runtime_ui_properties"
        uniform string info:sourceCode = "// This policy formats authoritative Modelica state for retained native UI.\nfn fmt(x) {((x*100.0).round()/100.0).to_string()}\nfn watts(x) {x.round().to_int().to_string()+\" W\"}\nfn drive_label(outputs) {\n let throttle=outputs[\"__member_Drivetrain_guidance_throttle\"];\n let steer=outputs[\"__member_Drivetrain_guidance_steer\"];\n if throttle==() || steer==() {return \"\";}\n let heading=outputs[\"__member_Drivetrain_guidance_heading_error\"];\n if heading!=() && abs(heading)>0.2 && abs(steer)>0.001 {return \"Turning\";}\n if throttle < -0.001 {return \"Reverse\";}\n if throttle > 0.001 {return \"Forward\";}\n if abs(steer)>0.001 {return \"Turning\";}\n \"Hold\"\n}\nfn runtime_ui_properties(facts) {\n let out=#{title:if facts.surface_id==\"energy-amber\" {\"YELLOW · LONG ROUTE\"} else {\"BLUE · SHORT ROUTE\"},case_color:if facts.surface_id==\"energy-amber\" {\"#FFAA40\"}else{\"#38BDFF\"},collected:\"—\",used:\"—\",balance:\"—\",charge:\"—\",current:\"Preparing power measurements\",elapsed:\"0m 0s\",solar_width:\"0px\",used_width:\"0px\",balance_color:\"#b7a3ff\"};\n if !facts.surface_id.starts_with(\"energy-\") {return #{};}\n for i in 0..facts.participants.len() {\n  let participant=facts.participants[i];let outputs=participant.outputs;\n  if outputs[\"energy_Solar_wh\"]==() {continue;}\n  let solar=outputs[\"energy_Solar_wh\"];\n  let used=0.0;let recovered=0.0;let demand=0.0;let valid=true;\n  for side in [\"FL\",\"FR\",\"RL\",\"RR\"] {\n   let value=outputs[\"energy_\"+side+\"_wh\"];\n   let back=outputs[\"energy_\"+side+\"_returned_wh\"];\n   let power=outputs[\"__member_Motor_\"+side+\"_electrical_power\"];\n   if value==() || back==() || power==() {valid=false;break;}\n   used+=value;recovered+=back;demand+=power;\n  }\n  let solar_w=outputs[\"solar_power\"];let soc=outputs[\"battery_soc\"];let elapsed=outputs[\"energy_elapsed_s\"];\n  if !valid || solar_w==() || soc==() || elapsed==() {continue;}\n  let equipment=outputs[\"energy_Equipment_wh\"];let charged=outputs[\"energy_Battery_wh\"];let discharged=outputs[\"energy_Battery_returned_wh\"];let battery_w=outputs[\"bus_power\"];let equipment_w=outputs[\"equipment_power\"];\n  if equipment==() || charged==() || discharged==() || battery_w==() || equipment_w==() {continue;}\n  let net=charged-discharged;used+=equipment-recovered;\n  out.collected=fmt(solar)+\" Wh\";out.used=fmt(used)+\" Wh\";out.balance=if net>=0.0 {\"+\"+fmt(net)+\" Wh\"}else{fmt(net)+\" Wh\"};\n  out.charge=fmt(soc*100.0)+\"%\";out.current=\"Solar \"+watts(solar_w)+\" · Motors \"+watts(demand)+\" · Other \"+watts(equipment_w)+\" · Battery \"+watts(battery_w);\n  let seconds=elapsed.round().to_int();out.elapsed=(seconds/60).to_string()+\"m \"+(seconds%60).to_string()+\"s\";\n  let mode=drive_label(outputs);\n  if mode!=\"\" {out.elapsed+=\" · \"+mode;}\n  out.solar_width=(min(solar,50.0)/50.0*170.0).to_string()+\"px\";out.used_width=(min(used,50.0)/50.0*170.0).to_string()+\"px\";\n  out.balance_color=if net>=0.0 {\"#79edaf\"}else{\"#b7a3ff\"};\n  break;\n }\n out\n}\n"
        bool lunco:policy:deterministic = false
    }
    over "Environment" (
        references = @twin://astrobotic-griffin-1/media/griffin_flip_v8/environments/south_pole_surrogate.usda@</SouthPoleSurrogate>
    )
    {
    }
    over "SolarSystem"
    {
        over "Looks"
        {
            over "Moon"
            {
                over "Shader"
                {
                    custom asset inputs:albedo_map = @twin://astrobotic-griffin-1/textures/moon/lroc_color_2025_8k.png@
                    color3f inputs:surface_color = (1.0, 1.0, 1.0)
                }
            }
        }
    }
}
