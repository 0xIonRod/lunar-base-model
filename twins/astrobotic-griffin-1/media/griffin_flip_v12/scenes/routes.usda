        def Scope "EnergySolar" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Sensors/PowerEnergyMeter.mo@
            custom double inputs:power_w
            double inputs:power_w.connect = </Griffin1SurfaceOps/FLIP_Amber.outputs:solar_power>
            custom double inputs:enabled
            double inputs:enabled.connect = </Griffin1SurfaceOps/FLIP_Amber.inputs:energy_count_enable>
            custom double outputs:positive_energy_wh = 0.0
            custom double outputs:negative_energy_wh = 0.0
            custom double outputs:net_energy_wh = 0.0
            custom double outputs:elapsed_s = 0.0
        }
