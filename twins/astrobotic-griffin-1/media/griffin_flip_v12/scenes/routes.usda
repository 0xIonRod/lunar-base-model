        double outputs:energy_RR_returned_wh.connect = </Griffin1SurfaceOps/FLIP/EnergyRR.outputs:negative_energy_wh>
        rel collection:components:includes = [</Griffin1SurfaceOps/FLIP/Drivetrain>, </Griffin1SurfaceOps/FLIP/Battery>, </Griffin1SurfaceOps/FLIP/SolarMechanism/Photovoltaics>, </Griffin1SurfaceOps/FLIP/Motor_FL>, </Griffin1SurfaceOps/FLIP/TorqueSource_FL>, </Griffin1SurfaceOps/FLIP/Gearbox_FL>, </Griffin1SurfaceOps/FLIP/Shaft_FL>, </Griffin1SurfaceOps/FLIP/Motor_FR>, </Griffin1SurfaceOps/FLIP/TorqueSource_FR>, </Griffin1SurfaceOps/FLIP/Gearbox_FR>, </Griffin1SurfaceOps/FLIP/Shaft_FR>, </Griffin1SurfaceOps/FLIP/Motor_RL>, </Griffin1SurfaceOps/FLIP/TorqueSource_RL>, </Griffin1SurfaceOps/FLIP/Gearbox_RL>, </Griffin1SurfaceOps/FLIP/Shaft_RL>, </Griffin1SurfaceOps/FLIP/Motor_RR>, </Griffin1SurfaceOps/FLIP/TorqueSource_RR>, </Griffin1SurfaceOps/FLIP/Gearbox_RR>, </Griffin1SurfaceOps/FLIP/Shaft_RR>, </Griffin1SurfaceOps/FLIP/EnergySolar>, </Griffin1SurfaceOps/FLIP/EnergyFL>, </Griffin1SurfaceOps/FLIP/EnergyFR>, </Griffin1SurfaceOps/FLIP/EnergyRL>, </Griffin1SurfaceOps/FLIP/EnergyRR>, </Griffin1SurfaceOps/FLIP/SolarCharger>, </Griffin1SurfaceOps/FLIP/Equipment>, </Griffin1SurfaceOps/FLIP/EnergyBattery>, </Griffin1SurfaceOps/FLIP/EnergyEquipment>]
        custom double outputs:energy_elapsed_s = 0.0
