        custom double outputs:energy_Battery_wh = 0.0
        double outputs:energy_Battery_wh.connect = </Griffin1SurfaceOps/FLIP/EnergyBattery.outputs:positive_energy_wh>
        custom double outputs:energy_Battery_returned_wh = 0.0
