        custom double outputs:energy_Equipment_returned_wh = 0.0
        double outputs:energy_Equipment_returned_wh.connect = </Griffin1SurfaceOps/FLIP/EnergyEquipment.outputs:negative_energy_wh>
        custom double3 xformOp:rotateXYZ = (0.0, 82.50562576904294, 0.0)
