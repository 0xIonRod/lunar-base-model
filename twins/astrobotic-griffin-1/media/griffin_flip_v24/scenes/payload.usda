#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
}

def Xform "Griffin1SurfaceOps" (
    references = [@twin://astrobotic-griffin-1/media/griffin_flip_v13/scenes/landing.usda@</Griffin1SurfaceOps>, @twin://astrobotic-griffin-1/scenes/griffin_1_surface_ops.usda@</Griffin1SurfaceOps>]
)
{
    over "FilmRecordingUI"
    {
        uniform string info:sourceCode = "fn select(facts) {[]}"
    }
    def Camera "FilmCamera" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        uniform token lunco:cameraRole = "viewport"
        uniform token lunco:cameraPose = "mounted"
        float horizontalAperture = 36.0
        float verticalAperture = 20.25
        float exposure:fStop = 16.0
        custom double3 xformOp:translate = (7.0, 8.0, 9.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double3 lunco:cameraLookAt = (0.0, 4.2, 0.0)
        float focalLength = 55.0
    }
    over Scope "FilmCapture" (
        active = false
    )
    {
    }
    def Scope "V24Capture" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/media/griffin_flip_v24/scenarios/capture.rhai@
        custom string film:scene = "payload"
        custom int film:frames = 180
        custom int film:pre_steps = 1200
        custom string film:camera = "PayloadView"
        custom double film:rate = 1.0
        custom double film:clock_scale = 1.0
    }
    over "Scenario"
    {
        over "Mission" (
            active = false
        )
        {
        }
    }
}
