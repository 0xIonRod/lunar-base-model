// @timing presentation
// Camera presentation only. Ten native 60 Hz cycles per 30 fps image = 5x.
const ROOT="/Griffin1SurfaceOps";
fn simulation_dependencies(me,ctx) {#{modelica_entities:[],entity_reads:[find_path(ROOT+"/FLIP"),find_path(ROOT+"/FLIP_Amber"),find_path(ROOT+"/Avatar"),find_path(ROOT+"/FLIP/SolarMechanism/Photovoltaics"),find_path(ROOT+"/FLIP_Amber/SolarMechanism/Photovoltaics")],entity_writes:[find_path(ROOT+"/Avatar")],query_reads:[],required_inputs:[]}}
fn wide() {cmd("SetCameraLookAt",#{camera:find_path(ROOT+"/Avatar"),eye:[-16.46215333887149,49.230282748857086,-43.63182421474647],target:[-7.9558111948738635,-0.7697172511429119,-16.288778602941452]});}
fn follow(name,front) {let r=find_path(ROOT+"/"+name);let p=world_pos(r);let f=world_forward3(r);let n=qrot(world_rotation_quat(find_path(ROOT+"/"+name+"/SolarMechanism/Photovoltaics")),vec3(0.0,1.0,0.0));let h=sqrt(n.x*n.x+n.z*n.z);if h<0.1 {return;}cmd("SetCameraLookAt",#{camera:find_path(ROOT+"/Avatar"),eye:[p[0]+6.0*n.x/h+front*f.x,p[1]+4.0,p[2]+6.0*n.z/h+front*f.z],target:[p[0],p[1]+0.4,p[2]]});}
fn on_start(me,ctx) {cmd("ActivatePerspective",#{id:"sandbox_view"});cmd("SetUserCamera",#{name:"Avatar"});cmd("SetTimeTransport",#{playing:true,rate:1.0});this.start_tick=clock_snapshot().sim_tick;cmd("StepSimulation",#{hold:true,steps:180});wide();set_twin_setting("ui.camera_status",false);set_twin_setting("ui.vehicle_controls",false);set_twin_setting("ui.mission_notifications",false);}
fn task(me,ctx) {let prev=-1;seq([wait_until(|m|clock_snapshot().sim_tick>=this.start_tick+180),once(|m|cmd("StartOfflineRecording",#{output_dir:ctx.output_path,fps:30})),#{kind:"step",act:|m|{let f=shot_frame();if f<0 || f==prev {return;}prev=f;cmd("StepSimulation",#{hold:true,steps:10});},done:|m|shot_frame()>=3600},once(|m|cmd("StopOfflineRecording",#{}))])}
