                custom rel material:binding:physics = </Griffin1SurfaceOps/FLIP/ContactMaterials/RegolithTread>
            }
        }
        over "Thermal" (
            active = false
        )
        {
        }
    }
    def LunCoPolicy "DrivePowerProperties"
    {
        uniform string lunco:policy:seam = "runtime.ui.surface"
        string lunco:policy:entry = "power_surface"
        bool lunco:policy:deterministic = false
        uniform asset info:sourceAsset = @../../policies/runtime_surfaces.rhai@
    }
    def Camera "SlopeView" (
        prepend references = @lunco://components/cameras/lunar_surface_camera.usda@</LunarSurfaceCamera>
    )
    {
        uniform token lunco:cameraRole = "viewport"
        uniform token lunco:cameraPose = "authored"
        float focalLength = 30.0
        float horizontalAperture = 36.0
        float verticalAperture = 20.25
        custom double3 xformOp:translate = (3.0, 2.5, -27.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
