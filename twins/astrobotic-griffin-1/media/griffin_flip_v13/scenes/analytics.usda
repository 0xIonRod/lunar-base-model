    def Scope "ComparisonGroups"
    {
        def PhysicsCollisionGroup "Blue"
        {
            rel collection:colliders:includes = </Griffin1SurfaceOps/FLIP>
            rel physics:filteredGroups = </Griffin1SurfaceOps/ComparisonGroups/Amber>
            uniform token collection:colliders:expansionRule = "expandPrims"
        }
        def PhysicsCollisionGroup "Amber"
        {
            rel collection:colliders:includes = </Griffin1SurfaceOps/FLIP_Amber>
            rel physics:filteredGroups = </Griffin1SurfaceOps/ComparisonGroups/Blue>
            uniform token collection:colliders:expansionRule = "expandPrims"
        }
    }
    def LunCoPolicy "MissionEnergyProperties"
    {
        uniform string lunco:policy:seam = "runtime.ui.surface"
        string lunco:policy:entry = "route_energy_surface"
        bool lunco:policy:deterministic = false
        uniform asset info:sourceAsset = @../../policies/runtime_surfaces.rhai@
    }
    over "Environment" (
        references = @twin://astrobotic-griffin-1/environments/south_pole_surrogate.usda@</SouthPoleSurrogate>
    )
    {
    }
    over "SolarSystem"
    {
        over "Looks"
        {
            over "Moon"
            {
                over "Shader"
                {
                    custom asset inputs:albedo_map = @twin://astrobotic-griffin-1/textures/moon/lroc_color_2025_8k.png@
                    color3f inputs:surface_color = (1.0, 1.0, 1.0)
                }
            }
        }
    }
