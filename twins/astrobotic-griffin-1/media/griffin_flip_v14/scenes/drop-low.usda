#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
}

def Xform "Griffin1SurfaceOps" (
    prepend references = @twin://astrobotic-griffin-1/media/griffin_flip_v13/scenes/drop-low.usda@</Griffin1SurfaceOps>
)
{
    over "FilmRecordingUI"
    {
        uniform string info:sourceCode = "fn select(facts) {[]}"
    }
    over "Lander"
    {
        double3 xformOp:translate = (0.0, 1.0, 0.0)
        vector3f physics:velocity = (0.0, 0.0, 0.0)
        over "LegPX"
        {
            vector3f physics:velocity = (0.0, 0.0, 0.0)
        }
        over "LegNX"
        {
            vector3f physics:velocity = (0.0, 0.0, 0.0)
        }
        over "LegPZ"
        {
            vector3f physics:velocity = (0.0, 0.0, 0.0)
        }
        over "LegNZ"
        {
            vector3f physics:velocity = (0.0, 0.0, 0.0)
        }
        over "GNC"
        {
            float inputs:initial_pos_y = 1.0
            float inputs:initial_vel_y = 0.0
        }
    }
    over Scope "FilmCapture"
    {
    }
}
