#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
}

def Xform "Griffin1SurfaceOps" (
    prepend references = @twin://astrobotic-griffin-1/media/griffin_flip_v13/scenes/drive.usda@</Griffin1SurfaceOps>
)
{
    over "FilmRecordingUI"
    {
        uniform string info:sourceCode = "fn select(facts) {[]}"
    }
    def Camera "FilmCamera" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        uniform token lunco:cameraRole = "viewport"
        uniform token lunco:cameraPose = "mounted"
        float horizontalAperture = 36.0
        float verticalAperture = 20.25
        float exposure:fStop = 16.0
        custom double3 xformOp:translate = (6.0, 3.2, 7.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double3 lunco:cameraLookAt = (0.0, 1.3, 0.0)
        float focalLength = 38.0
        float exposure:time = 0.00390625
        float exposure:iso = 100.0
        float exposure:responsivity = 1.0
    }
    over "FLIP"
    {
        string lunco:ui:surfaceId = ""
    }
    over Scope "Policies"
    {
    }
    over "FilmViews"
    {
        uniform string info:sourceCode = "fn assemble(facts) {[#{id:\"film-model\",title:\"FLIP model\",description:\"Exported power network and its values\",interaction:\"editor\",restore:false,right:[\"telemetry_browser\"],instances:[#{kind:\"modelica_model_view\",instance:1,slot:\"center\"}]}]}"
    }
    def Camera "SlopeWide" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        uniform token lunco:cameraRole = "viewport"
        uniform token lunco:cameraPose = "mounted"
        float horizontalAperture = 36.0
        float verticalAperture = 20.25
        float exposure:fStop = 16.0
        custom double3 xformOp:translate = (-10.0, 8.0, -17.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double3 lunco:cameraLookAt = (1.0, 0.0, -6.0)
        float focalLength = 32.0
        float exposure:time = 0.00390625
        float exposure:iso = 100.0
        float exposure:responsivity = 1.0
    }
    over Scope "FilmCapture"
    {
    }
}
