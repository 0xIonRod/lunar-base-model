#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
}

def Xform "Griffin1SurfaceOps" (
    references = @twin://astrobotic-griffin-1/media/griffin_flip_v13/scenes/landing.usda@</Griffin1SurfaceOps>
)
{
    over "FilmRecordingUI"
    {
        uniform string info:sourceCode = "fn select(facts) {[]}"
    }
    def Camera "FilmCamera" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        uniform token lunco:cameraRole = "viewport"
        uniform token lunco:cameraPose = "mounted"
        float horizontalAperture = 36.0
        float verticalAperture = 20.25
        float exposure:fStop = 16.0
        custom double3 xformOp:translate = (8.0, 2.8, 7.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double3 lunco:cameraLookAt = (2.0, 1.0, 1.8)
        float focalLength = 45.0
        float exposure:time = 0.00390625
        float exposure:iso = 100.0
        float exposure:responsivity = 1.0
    }
    def BasisCurves "FilmPath" (
        prepend apiSchemas = ["LunCoCameraPathAPI"]
    )
    {
        uniform token type = "linear"
        uniform token basis = "bezier"
        uniform token wrap = "nonperiodic"
        int[] curveVertexCounts = [2]
        point3f[] points = [(8.0, 2.799999952316284, 7.0), (7.0, 2.5999999046325684, 6.599999904632568)]
        double lunco:path:duration = 12.0
        token lunco:path:clock = "real"
        token visibility = "invisible"
        rel lunco:path:camera = </Griffin1SurfaceOps/FilmCamera>
        rel lunco:path:lookAt = </Griffin1SurfaceOps/LegAim>
    }
    def Xform "LegAim"
    {
        custom double3 xformOp:translate = (1.8, 0.65, 1.4)
    }
    over Scope "FilmCapture"
    {
    }
}
