#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
}

def Xform "Griffin1SurfaceOps" (
    prepend references = @twin://astrobotic-griffin-1/media/griffin_flip_v13/scenes/drop-low.usda@</Griffin1SurfaceOps>
)
{
    over "FilmRecordingUI"
    {
        uniform string info:sourceCode = "fn select(facts) {[]}"
    }
    over "FLIP"
    {
        custom string lunco:ui:surfaceId = ""
    }
    over Scope "FilmCapture"
    {
    }
    def Scope "V18Recorder" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/media/griffin_flip_v18/scenarios/leg_contact_capture.rhai@
    }
    def Camera "V18Camera" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        uniform token lunco:cameraRole = "viewport"
        uniform token lunco:cameraPose = "authored"
        custom double3 xformOp:translate = (7.0, 2.0, 6.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float horizontalAperture = 36.0
        float verticalAperture = 20.25
        float focalLength = 55.0
        float exposure:fStop = 16.0
        float exposure:time = 0.00390625
        float exposure:iso = 100.0
    }
}
