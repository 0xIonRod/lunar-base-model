<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!-- Griffin-1 FLIP route; targets are scene-local. The first two targets
         are the physical deck approach and ramp exit before the base-site leg. -->
    <BehaviorTree ID="MainTree">
        <Sequence>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverRampApproach" speed="0.22" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverRampExit" speed="0.22" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverTarget1" speed="0.35" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverTransit1" speed="0.35" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverTransit2" speed="0.35" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverTransit3" speed="0.35" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverTransit4" speed="0.35" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverTransit5" speed="0.35" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverTransit6" speed="0.35" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverTarget2" speed="0.35" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverBaseArc1" speed="0.30" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverBaseArc2" speed="0.30" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverBaseApproach" speed="0.30" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/RoverBaseFinal" speed="0.30" radius="2.5"/>
        <Action ID="drive_to" target="/Griffin1SurfaceOps/BaseSite" speed="0.30" radius="2.5"/>
        </Sequence>
  </BehaviorTree>
</root>
