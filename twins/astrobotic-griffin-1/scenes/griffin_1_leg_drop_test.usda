#usda 1.0
(
    defaultPrim = "World"
)

def Xform "World"
{
    def PhysicsScene "MoonPhysics"
    {
        float3 physics:gravityDirection = (0.0, -1.0, 0.0)
        float physics:gravityMagnitude = 1.6200000047683716
    }
    def Cube "Ground" (
        prepend apiSchemas = "PhysicsCollisionAPI"
    )
    {
        double size = 100.0
        custom double3 xformOp:translate = (0.0, -352.0, 0.0)
        custom token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        custom double3 xformOp:scale = (14.0, 0.1, 14.0)
        bool physics:collisionEnabled = true
    }
    def Xform "Lander" (
        prepend references = @twin://astrobotic-griffin-1/vehicles/griffin_1.usda@</Griffin1>
    )
    {
        custom double3 xformOp:translate = (0.0, 1000.0, 0.0)
        custom token[] xformOpOrder = ["xformOp:translate"]
        double3 physics:velocity = (0.0, -0.5, 0.0)
    }
    def DistantLight "KeyLight"
    {
        float intensity = 0.550000011920929
        float angle = 0.5
        custom double3 xformOp:rotateXYZ = (-34.99999237060547, -34.999996185302734, -0.0000010422651257613325)
        custom token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Camera "Avatar" (
        prepend references = @lunco://components/cameras/lunar_surface_camera.usda@</LunarSurfaceCamera>
        prepend apiSchemas = "LunCoAvatarAPI"
    )
    {
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        custom double3 xformOp:translate = (1400.0, 900.0, 1600.0)
        custom token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        custom double3 xformOp:rotateXYZ = (-160.0, -40.00000762939453, 180.0)
    }
    def Camera "TestCamera" (
        prepend references = @lunco://components/cameras/lunar_surface_camera.usda@</LunarSurfaceCamera>
    )
    {
        custom double3 xformOp:translate = (1400.0, 900.0, 1600.0)
        custom token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        custom double3 xformOp:rotateXYZ = (-19.999998092651367, 39.999996185302734, -0.0000005572611030402186)
    }
}
