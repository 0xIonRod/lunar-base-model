#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Griffin1SurfaceOps" (
    prepend references = @twin://astrobotic-griffin-1/environments/lunar_surface_base.usda@</LunarSurface>
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
    kind = "assembly"
    doc = "Griffin-1 landing study: guided descent, touchdown, top-deck FLIP egress, and bounded rover operations."
)
{
    uniform bool lunco:spawnable = false
    double lunco:anchor:lat = -84.72672255
    double lunco:anchor:lon = 29.14428685
    double lunco:anchor:height = 0.0
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461448.2197239352
    custom string lunco:mission:id = "M02"
    custom string lunco:mission:name = "Astrobotic Griffin Mission One"
    custom string lunco:mission:site = "Nobile regional study anchor backed by LROC NAC DTM NOBILE03; exact touchdown coordinate unresolved"
    custom string lunco:mission:scope = "surface operations only"
    custom string lunco:mission:evidence = "LROC NOBILE03 regional relief is source-backed; Griffin vehicle values and exact touchdown site remain assumptions"
    custom string lunco:mission:deployment = "\"Explicit DEPLOY FLIP: qualified landing, balanced rear-wheel sling preload, adapter retirement, guarded descent, fixed four-wheel ground transfer, unloading and restraint release before manual drive. Reduced balanced sling and powered winches are study assumptions; flight end rigging is unresolved.\""
    custom string lunco:anchor:status = "MOON_ME ENU frame at NOBILE03 regional center; local height zero is the normalized terrain datum"
    custom string lunco:lighting:contract = "all Griffin and FLIP geometry uses LunarSurface/Sun polar direction and the authored mission epoch"
    custom string lunco:route:status = "hidden ramp-entry navigation datum remains outside descent column; center lane remains clear of four solid legs"
    custom string lunco:terrain:source = "twin://astrobotic-griffin-1/Assets.toml#nobile03_dem.process -> native pipeline -> .cache/terrain/nobile03 (.pipeline.toml)"
    def "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
    def Xform "Environment" (
        prepend references = @twin://astrobotic-griffin-1/environments/south_pole_surrogate.usda@</SouthPoleSurrogate>
    )
    {
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoAvatarAPI"]
        prepend references = @lunco://components/cameras/lunar_surface_camera.usda@</LunarSurfaceCamera>
    )
    {
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        custom double3 xformOp:translate = (30.0, 30.0, 30.0)
        custom token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        custom double3 xformOp:rotateXYZ = (-31.65, 45.0, 0.0)
    }
    def Xform "TrackingCameraStation" (
        prepend references = @twin://astrobotic-griffin-1/components/cameras/object_tracking_camera.usda@</ObjectTrackingCamera>
        doc = "Ground-level virtual two-axis tracking camera at the marked south-east landing-site overlook; no rendered mast or camera body."
    )
    {
        custom double3 xformOp:translate = (11.0, 0.0, 20.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        custom rel lunco:tracking:trackedObject = </Griffin1SurfaceOps/Lander>
        custom string lunco:tracking:role = "remote landing and surface-operations observer"
        over "Controller"
        {
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/models/GriffinTrackingCameraGround.mo@
            double parameters:mount_x_m = 11.0
            double parameters:mount_y_m = 2.0
            double parameters:mount_z_m = 20.0
            double parameters:initial_pan_rad = 0.5028432109278608
            double parameters:initial_tilt_rad = 1.1958697313651445
            double outputs:pan_angle_rad = 0.5028432109278608
            double outputs:tilt_angle_rad = 1.1958697313651445
            double inputs:target_x_m
            double inputs:target_x_m.connect = </Griffin1SurfaceOps/Lander.outputs:position_x>
            double inputs:target_y_m
            double inputs:target_y_m.connect = </Griffin1SurfaceOps/Lander.outputs:position_y>
            double inputs:target_z_m
            double inputs:target_z_m.connect = </Griffin1SurfaceOps/Lander.outputs:position_z>
        }
        over "GimbalBase"
        {
            custom double3 xformOp:translate = (0.0, 2.0, 0.0)
        }
        over "TiltHead"
        {
            custom double3 xformOp:translate = (0.0, 2.0, 0.0)
            quatf xformOp:orient = (0.8005145192146301, 0.5452379584312439, 0.20561757683753967, -0.1400480568408966)
            over "GriffinTrackingCamera"
            {
                custom rel lunco:tracking:trackedObject = </Griffin1SurfaceOps/Lander>
                float focalLength = 18.0
                float2 clippingRange = (0.5, 500000000.0)
            }
        }
        over "PanYoke"
        {
            custom double3 xformOp:translate = (0.0, 2.0, 0.0)
            quatf xformOp:orient = (0.968559741973877, 0.0, 0.24878111481666565, 0.0)
        }
        over "CameraPanJoint"
        {
            float drive:angular:physics:targetPosition = 28.810792922973633
            double inputs:angle = 0.5028432109278608
        }
        over "CameraTiltJoint"
        {
            float drive:angular:physics:targetPosition = 68.5182876586914
            double inputs:angle = 1.1958697313651445
        }
    }
    def Scope "CameraTrack" (
        prepend apiSchemas = ["LunCoCameraTrackAPI"]
    )
    {
        token lunco:activeCamera
        token lunco:activeCamera.timeSamples = {
            0.0: "GriffinTrackingCamera",
        }
    }
    def "Lander" (
        prepend references = [@twin://astrobotic-griffin-1/vehicles/griffin_1.usda@</Griffin1>, @lunco://components/gnc/position_pid_guidance.usda@</PositionPIDGuidance>]
        doc = "Final-approach study starts at 60 m with all connected rigid bodies at rest, yawed 172.483 degrees toward the Sun at the authored site/epoch. Guidance immediately descends while tracking solar heading. The initial yaw is an epoch-specific study value, not a flight attitude plan."
    )
    {
        double3 xformOp:translate = (0.0, 60.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
        float inputs:guidance_throttle
        float inputs:guidance_throttle.connect = </Griffin1SurfaceOps/Lander/GNC.outputs:throttle_cmd>
        float inputs:guidance_pitch
        float inputs:guidance_pitch.connect = </Griffin1SurfaceOps/Lander/GNC.outputs:pitch_cmd>
        float inputs:guidance_roll
        float inputs:guidance_roll.connect = </Griffin1SurfaceOps/Lander/GNC.outputs:roll_cmd>
        float inputs:guidance_yaw
        float inputs:guidance_yaw.connect = </Griffin1SurfaceOps/Lander/GNC.outputs:yaw_cmd>
        float inputs:landing_engine_cutoff
        float inputs:landing_engine_cutoff.connect = </Griffin1SurfaceOps/Lander/GNC.outputs:landing_engine_cutoff>
        float inputs:landing_handoff
        float inputs:landing_handoff.connect = </Griffin1SurfaceOps/Lander/GNC.outputs:landing_handoff>
        custom double xformOp:rotateY = 172.483
        vector3f physics:velocity = (0.0, 0.0, 0.0)
        over "GNC"
        {
            float inputs:initial_pos_x = 0.0
            float inputs:initial_pos_y = 60.0
            float inputs:initial_pos_z = 0.0
            float inputs:initial_vel_x = 0.0
            float inputs:initial_vel_y = 0.0
            float inputs:initial_vel_z = 0.0
            float inputs:touchdown
            float inputs:touchdown.connect = </Griffin1SurfaceOps/Lander.outputs:touchdown>
            float inputs:engine_cutoff_contact
            float inputs:engine_cutoff_contact.connect = </Griffin1SurfaceOps/Lander.outputs:engine_cutoff_contact>
            float inputs:any_leg_contact
            float inputs:any_leg_contact.connect = </Griffin1SurfaceOps/Lander.outputs:any_leg_contact>
            float inputs:landing_contact
            float inputs:landing_contact.connect = </Griffin1SurfaceOps/Lander.outputs:landing_contact>
            float inputs:altimeter_range
            float inputs:altimeter_range.connect = </Griffin1SurfaceOps/Lander/Altimeter/Model.outputs:range_m>
            float inputs:altimeter_position_valid
            float inputs:altimeter_position_valid.connect = </Griffin1SurfaceOps/Lander/Altimeter/Model.outputs:range_valid>
            float inputs:altimeter_altitude_confidence
            float inputs:altimeter_altitude_confidence.connect = </Griffin1SurfaceOps/Lander/Altimeter/Model.outputs:range_confidence>
            float inputs:altimeter_vehicle_position_x
            float inputs:altimeter_vehicle_position_x.connect = </Griffin1SurfaceOps/Lander/Altimeter/Model.outputs:vehicle_position_x>
            float inputs:altimeter_vehicle_position_y
            float inputs:altimeter_vehicle_position_y.connect = </Griffin1SurfaceOps/Lander/Altimeter/Model.outputs:vehicle_position_y>
            float inputs:altimeter_vehicle_position_z
            float inputs:altimeter_vehicle_position_z.connect = </Griffin1SurfaceOps/Lander/Altimeter/Model.outputs:vehicle_position_z>
            float inputs:imu_coordinate_accel_local_x
            float inputs:imu_coordinate_accel_local_x.connect = </Griffin1SurfaceOps/Lander/IMU.outputs:coordinate_accel_local_x>
            float inputs:imu_coordinate_accel_local_y
            float inputs:imu_coordinate_accel_local_y.connect = </Griffin1SurfaceOps/Lander/IMU.outputs:coordinate_accel_local_y>
            float inputs:imu_coordinate_accel_local_z
            float inputs:imu_coordinate_accel_local_z.connect = </Griffin1SurfaceOps/Lander/IMU.outputs:coordinate_accel_local_z>
            float inputs:imu_attitude_quat_w
            float inputs:imu_attitude_quat_w.connect = </Griffin1SurfaceOps/Lander/IMU.outputs:attitude_quat_w>
            float inputs:imu_attitude_quat_x
            float inputs:imu_attitude_quat_x.connect = </Griffin1SurfaceOps/Lander/IMU.outputs:attitude_quat_x>
            float inputs:imu_attitude_quat_y
            float inputs:imu_attitude_quat_y.connect = </Griffin1SurfaceOps/Lander/IMU.outputs:attitude_quat_y>
            float inputs:imu_attitude_quat_z
            float inputs:imu_attitude_quat_z.connect = </Griffin1SurfaceOps/Lander/IMU.outputs:attitude_quat_z>
            float inputs:target_x
            float inputs:target_x.connect = </Griffin1SurfaceOps/LandingTarget.outputs:position_x>
            float inputs:target_y
            float inputs:target_y.connect = </Griffin1SurfaceOps/LandingTarget.outputs:position_y>
            float inputs:target_z
            float inputs:target_z.connect = </Griffin1SurfaceOps/LandingTarget.outputs:position_z>
            float inputs:command_tilt_limit_rad
            float inputs:command_tilt_limit_rad.connect = </Griffin1SurfaceOps/Lander.inputs:command_tilt_limit_rad>
            float inputs:kp_x = 0.11999999731779099
            float inputs:ki_x = 0.0
            float inputs:kd_x = 0.800000011920929
            float inputs:kp_z = 0.11999999731779099
            float inputs:ki_z = 0.0
            float inputs:kd_z = 0.800000011920929
            float inputs:max_lateral_accel = 1.5
            float inputs:landing_flare_range_m = 12.0
            float inputs:descent_speed_limit_mps = 2.5
            float inputs:descent_braking_accel_mps2 = 6.0
            double inputs:vehicle_mass
            double inputs:vehicle_mass.connect = </Griffin1SurfaceOps/Lander.outputs:dynamic_joint_island_mass_kg>
            double inputs:mass_properties_valid
            double inputs:mass_properties_valid.connect = </Griffin1SurfaceOps/Lander.outputs:dynamic_joint_island_mass_valid>
            float inputs:max_thrust = 21796.28515625
            float inputs:piloted
            float inputs:piloted.connect = </Griffin1SurfaceOps/Lander.outputs:piloted>
            custom double outputs:flight_authority_gate = 0.0
        }
        def "RampHingePort"
        {
        }
        def "RampHingeStarboard"
        {
        }
        over "AttitudeReference" (
            doc = "Forward solar-bank +Z faces Sun azimuth during automatic descent. IMU thrust tilt retains priority; first pilot flight input disables heading hold through the GNC authority gate."
        )
        {
            custom double inputs:heading_enable
            double inputs:heading_enable.connect = </Griffin1SurfaceOps/Lander/GNC.outputs:flight_authority_gate>
            custom double inputs:heading_target_body_x
            double inputs:heading_target_body_x.connect = </Griffin1SurfaceOps/Lander/Environment.outputs:sun_mount_x>
            custom double inputs:heading_target_body_y
            double inputs:heading_target_body_y.connect = </Griffin1SurfaceOps/Lander/Environment.outputs:sun_mount_y>
            custom double inputs:heading_target_body_z
            double inputs:heading_target_body_z.connect = </Griffin1SurfaceOps/Lander/Environment.outputs:sun_mount_z>
            custom double parameters:heading_tolerance_rad = 0.08726646259971647
            custom double parameters:heading_rate_tolerance_rad_s = 0.02
        }
    }
    def "FLIP" (
        references = @twin://astrobotic-griffin-1/vehicles/flip_v5.usda@</FLIP>
    )
    {
        custom double3 xformOp:translate = (0.0, 62.82, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        double3 physics:velocity = (0.0, 0.0, 0.0)
        custom token lunco:mission:deploymentState = "top_deck_attached_until_touchdown"
        custom double3 xformOp:rotateXYZ = (0.0, 82.483, 0.0)
        custom rel programs = </Griffin1SurfaceOps/FlipRoute/Program>
        over "SolarMechanism"
        {
            double3 xformOp:rotateXYZ = (0.0, 0.0, 0.0)
            over "Controller"
            {
                double inputs:command_deg = 0.0
                double inputs:initial_deg = 0.0
                double outputs:angle = 0.0
                double outputs:deployment_deg = 0.0
            }
        }
        over "PanelHinge"
        {
            float drive:angular:physics:targetPosition = 0.0
            double inputs:angle = 0.0
        }
        over "Suspension_FL"
        {
            over "Wheel_FL"
            {
                custom double outputs:fixed_contact = 0.0
                custom double inputs:brake = 0.0
                custom double outputs:loaded_contact = 0.0
            }
        }
        over "Suspension_FR"
        {
            over "Wheel_FR"
            {
                custom double outputs:fixed_contact = 0.0
                custom double inputs:brake = 0.0
                custom double outputs:loaded_contact = 0.0
            }
        }
        over "Suspension_RL"
        {
            over "Wheel_RL"
            {
                custom double outputs:fixed_contact = 0.0
                custom double inputs:brake = 0.0
                custom double outputs:loaded_contact = 0.0
            }
        }
        over "Suspension_RR"
        {
            over "Wheel_RR"
            {
                custom double outputs:fixed_contact = 0.0
                custom double inputs:brake = 0.0
                custom double outputs:loaded_contact = 0.0
            }
        }
    }
    def PhysicsFixedJoint "FLIPPayloadAdapterJoint"
    {
        rel physics:body0 = </Griffin1SurfaceOps/Lander>
        rel physics:body1 = </Griffin1SurfaceOps/FLIP>
        point3f physics:localPos0 = (0.0, 2.119999885559082, 0.0)
        point3f physics:localPos1 = (0.0, -0.699999988079071, 0.0)
        quatf physics:localRot1 = (1.0, 0.0, 0.0, 0.0)
        quatf physics:localRot0 = (0.7071067690849304, 0.0, -0.7071067690849304, 0.0)
    }
    def Scope "FLIPEgressInterface"
    {
        custom rel lunco:mission:payloadDeck = </Griffin1SurfaceOps/Lander/Bus/RoverPayloadDeck>
        custom rel lunco:mission:adapterJoint = </Griffin1SurfaceOps/FLIPPayloadAdapterJoint>
    }
    def Xform "RoverRampApproach"
    {
        custom double3 xformOp:translate = (2.0, 0.2049314542207867, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool lunco:billboard = false
    }
    def Xform "RoverRampExit"
    {
        custom double3 xformOp:translate = (8.5, -0.0062310658970091, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool lunco:billboard = false
    }
    def Xform "RoverTarget1"
    {
        custom double3 xformOp:translate = (13.0, -0.14148472641245463, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool lunco:billboard = false
    }
    def Xform "RoverTarget2"
    {
        custom double3 xformOp:translate = (22.0, -1.067371954023838, -4.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool lunco:billboard = false
    }
    def Xform "BaseSite"
    {
        custom double3 xformOp:translate = (31.0, -2.166758555790875, -10.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool lunco:billboard = false
    }
    def Xform "LandingTarget" (
        prepend references = @lunco://components/gnc/landing_target.usda@</LandingTarget>
    )
    {
        custom double3 xformOp:translate = (0.0, 0.6187641942501068, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Dome"
        {
            token visibility = "invisible"
        }
        over "SurfaceMark"
        {
            token visibility = "invisible"
        }
        over "Presentation" (
            active = false
        )
        {
        }
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "griffin-1-surface-ops"
        def Scope "Mission" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/griffin_1_surface_ops.rhai@
        }
    }
    def Scope "FlipRoute" (
        doc = "Operator route for FLIP: Alt+left-click adds a point to this route while FLIP is selected or possessed; the action key starts or stops following. Points live in the runtime layer and are not saved (usd.runtime_persistence is false)."
    )
    {
        def Scope "Program" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/route_follow.rhai@
            float inputs:enabled = 0.0
            custom rel inputs:subject = </Griffin1SurfaceOps/FLIP>
        }
    }
    def Xform "StarfieldSky" (
        prepend references = @lunco://components/environment/starfield_sky.usda@</StarfieldSky>
    )
    {
    }
    def Scope "EgressTether" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/models/GriffinTetherPairStudy.mo@
        custom double inputs:regulate = 0.0
