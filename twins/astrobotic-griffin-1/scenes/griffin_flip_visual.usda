            double3 xformOp:translate = (-10.0, 0.42, 3.8)
            double3 xformOp:scale = (1.4, 0.8, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.20000000298023224, 0.1899999976158142, 0.18000000715255737)]
