    def DomeLight "ReviewFill"
    {
        float inputs:intensity = 18000.0
        float inputs:exposure = 2.0
        color3f inputs:color = (0.6200000047683716, 0.6800000071525574, 0.7799999713897705)
    }
    over "Sun"
    {
        float inputs:intensity = 120000.0
    }
    def Camera "VisualCamera" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
        prepend references = @lunco://components/cameras/lunar_surface_camera.usda@</LunarSurfaceCamera>
    )
    {
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (1.5, 2.2, 0.0)
        double3 xformOp:translate = (17.0, 8.5, 16.0)
        float focalLength = 32.0
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "CameraTrack" (
        prepend apiSchemas = "LunCoCameraTrackAPI"
    )
    {
        token lunco:activeCamera
        token lunco:activeCamera.timeSamples = {
            0.0: "VisualCamera",
        }
    }
    def Scope "Scenario"
    {
        def Scope "Mission" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_flip_visual.rhai@
        }
    }
    def Xform "Environment" (
        references = @twin://astrobotic-griffin-1/environments/south_pole_surrogate.usda@
    )
    {
        over "VisualBerms"
        {
            def "BermEast"
            {
                token visibility = "invisible"
            }
            def "BermWest"
            {
                token visibility = "invisible"
            }
        }
    }
}
