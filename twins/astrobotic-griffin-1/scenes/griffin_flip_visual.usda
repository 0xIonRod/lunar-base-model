#usda 1.0
(
    defaultPrim = "GriffinFlipVisual"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "GriffinFlipVisual" (
    prepend references = @twin://astrobotic-griffin-1/environments/lunar_surface_base.usda@</LunarSurface>
    kind = "assembly"
    documentation = "Griffin-1 and Astrolab FLIP visual review composition; SI metres."
    prepend apiSchemas = "LunCoEpochAPI"
)
{
    custom string lunco:visual:status = "review-ready proxy geometry, not flight CAD"
    custom string lunco:visual:ownership = "Twin USD owns topology/material placement; Rhai owns visual acceptance"
    custom string lunco:visual:camera = "VisualCamera"
    custom token lunco:visual:terrain_mode = "standard_layered"
    custom asset lunco:visual:terrain_asset = @twin://astrobotic-griffin-1/environments/south_pole_surrogate.usda@
    custom asset lunco:visual:terrain_shader = @lunco://shaders/terrain_layered.wgsl@
    double lunco:anchor:lat = -84.72672255
    double lunco:anchor:lon = 29.14428685
    double lunco:anchor:height = 0.0
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def Xform "Ground"
    {
        def Cube "RegolithPad"
        {
            double size = 1.0
            double3 xformOp:translate = (3.0, -0.35, 0.0)
            double3 xformOp:scale = (36.0, 0.35, 14.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.12999999523162842, 0.11999999731779099, 0.10999999940395355)]
            bool physics:collisionEnabled = false
            uniform token purpose = "render"
            token visibility = "invisible"
        }
        def Cylinder "LandingPad"
        {
            float radius = 6.0
            float height = 0.1599999964237213
            uniform token axis = "Y"
            double3 xformOp:translate = (0.0, 0.08, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.25999999046325684, 0.27000001072883606, 0.28999999165534973)]
            bool physics:collisionEnabled = false
            uniform token purpose = "guide"
            token visibility = "invisible"
        }
        def Cylinder "PadRing"
        {
            float radius = 5.400000095367432
            float height = 0.1899999976158142
            uniform token axis = "Y"
            double3 xformOp:translate = (0.0, 0.18, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.6499999761581421, 0.47999998927116394, 0.18000000715255737)]
            bool physics:collisionEnabled = false
            uniform token purpose = "guide"
            token visibility = "invisible"
        }
    }
    def Xform "Griffin1" (
        references = @twin://astrobotic-griffin-1/vehicles/griffin_1.usda@</Griffin1>
    )
    {
        bool physics:rigidBodyEnabled = false
        custom double3 xformOp:translate = (0.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "FLIP" (
        prepend references = @twin://astrobotic-griffin-1/vehicles/flip_visual.usda@</FLIP>
    )
    {
        bool physics:rigidBodyEnabled = false
        custom double3 xformOp:translate = (0.0, 6.15, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def DomeLight "ReviewFill"
    {
        float inputs:intensity = 18000.0
        float inputs:exposure = 2.0
        color3f inputs:color = (0.6200000047683716, 0.6800000071525574, 0.7799999713897705)
    }
    over "Sun"
    {
        float inputs:intensity = 120000.0
    }
    def Camera "VisualCamera" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
        prepend references = @lunco://components/cameras/lunar_surface_camera.usda@</LunarSurfaceCamera>
    )
    {
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (1.5, 2.2, 0.0)
        double3 xformOp:translate = (17.0, 8.5, 16.0)
        float focalLength = 32.0
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "CameraTrack" (
        prepend apiSchemas = "LunCoCameraTrackAPI"
    )
    {
        token lunco:activeCamera
        token lunco:activeCamera.timeSamples = {
            0.0: "VisualCamera",
        }
    }
    def Scope "Scenario"
    {
        def Scope "Mission" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_flip_visual.rhai@
        }
    }
    def Xform "Environment" (
        references = @twin://astrobotic-griffin-1/environments/south_pole_surrogate.usda@
    )
    {
        over "VisualBerms"
        {
            def "BermEast"
            {
                token visibility = "invisible"
            }
            def "BermWest"
            {
                token visibility = "invisible"
            }
        }
    }
    def Xform "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
}
