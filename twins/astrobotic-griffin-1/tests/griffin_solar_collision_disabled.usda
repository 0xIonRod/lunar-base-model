        )
        {
            double radius = 0.02
            float physics:mass = 1.0
            bool physics:collisionEnabled = true
            vector3f physics:velocity = (0.0, -0.5, 0.0)
            custom double3 xformOp:translate = (0.11287499964237213, 0.3, -0.48912499845027924)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Sphere "ProbeBottom" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
        )
        {
            double radius = 0.02
