            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Sphere "OpeningProbe" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
        )
        {
            double radius = 0.02
            float physics:mass = 1.0
            bool physics:collisionEnabled = true
            vector3f physics:velocity = (0.0, -0.5, 0.0)
            custom double3 xformOp:translate = (-0.7525000000000001, 0.3, 0.2257499999999999)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
    def Xform "Panel2" (
        references = @../components/lander/griffin_solar_panel_port_visual.usda@
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        custom double3 xformOp:translate = (6.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:kinematicEnabled = true
        def Sphere "ProbeTop" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
        )
        {
            double radius = 0.02
            float physics:mass = 1.0
            bool physics:collisionEnabled = true
            vector3f physics:velocity = (0.0, -0.5, 0.0)
