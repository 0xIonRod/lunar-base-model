#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
}

def Xform "Griffin1SurfaceOps" (
    prepend references = @twin://astrobotic-griffin-1/tests/flip_route_follow.usda@</Griffin1SurfaceOps>
)
{
    over "FLIP"
    {
        custom double3 xformOp:translate = (0.0, 50.0, 0.0)
        custom token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "WrenchProbe" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/tests/GriffinTetherWrenchProbe.mo@
        float inputs:force_x = 0.0
        float inputs:torque_y = 0.0
    }
    over "Scenario"
    {
        over "Test"
        {
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_tether_wrench_response.rhai@
        }
    }
}
