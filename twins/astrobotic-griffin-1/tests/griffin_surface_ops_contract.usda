#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Griffin1SurfaceOps" (
    prepend references = @twin://astrobotic-griffin-1/scenes/griffin_1_surface_ops.usda@</Griffin1SurfaceOps>
    kind = "assembly"
    documentation = "Twin-owned Griffin surface-operations contract and repeatability test."
)
{
    over "Scenario"
    {
    }
    def Scope "LandingStability"
    {
        def Scope "Observer" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_surface_ops_contract.rhai@
        }
    }
}
