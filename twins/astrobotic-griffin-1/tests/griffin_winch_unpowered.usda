#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World" (
    prepend references = @twin://astrobotic-griffin-1/tests/griffin_winch_power.usda@</World>
)
{
    over "WinchPower"
    {
        over "Battery"
        {
            custom double parameters:soc_init = 0.0
        }
    }
    over "WinchObservation"
    {
        over "Program"
        {
            custom bool inputs:initially_unpowered = true
        }
    }
}
