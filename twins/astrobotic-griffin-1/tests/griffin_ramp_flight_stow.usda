#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
    def DistantLight "KeyLight"
    {
        float intensity = 0.55
        float angle = 0.5
        custom double3 xformOp:rotateXYZ = (-35.0, -35.0, 0.0)
        custom token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Xform "Griffin1" (
        references = @twin://astrobotic-griffin-1/vehicles/griffin_1.usda@</Griffin1>
    )
    {
    }
    def Scope "Scenario"
    {
        def Scope "Mission" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_ramp_flight_stow.rhai@
        }
    }
}
