#usda 1.0
(
    defaultPrim = "GriffinRequirementsTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# A minimal composed fixture for the Griffin wrapper contract. It is separate
# from the surface mission so a structural failure cannot be hidden by terrain,
# FLIP, guidance, or the descent/release lifecycle.
def Xform "GriffinRequirementsTest" (
    kind = "assembly"
    documentation = "Twin-owned Griffin-1 requirements and limiter fixture."
)
{
    uniform bool lunco:spawnable = false

    def Xform "Griffin1" (
        prepend references = @twin://astrobotic-griffin-1/vehicles/griffin_1.usda@</Griffin1>
    )
    {
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "griffin-requirements"

        def Scope "Mission" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_requirements.rhai@
        }
    }
}
