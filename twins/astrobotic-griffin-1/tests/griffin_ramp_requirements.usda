#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
    def Xform "Griffin1" (
        prepend references = @twin://astrobotic-griffin-1/vehicles/griffin_1.usda@</Griffin1>
    )
    {
        def "EgressRampPort"
        {
            custom double3 xformOp:rotateXYZ = (0.0, 0.0, -37.42458435132686)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def "EgressRampStarboard"
        {
            custom double3 xformOp:rotateXYZ = (0.0, 180.0, 37.42458435132686)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
    }
    def Scope "Scenario"
    {
        def Scope "Mission" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_ramp_requirements.rhai@
        }
    }
}
