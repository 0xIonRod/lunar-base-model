#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
    def Xform "Griffin1" (
        references = @twin://astrobotic-griffin-1/vehicles/griffin_1.usda@</Griffin1>
    )
    {
        // This fixture checks the deployed physical deck interface. The
        // scenario verifies these pose angles against the SysML datums;
        // transport stow is covered by griffin_ramp_flight_stow.usda.
        over "EgressRampPort"
        {
            custom double3 xformOp:rotateXYZ = (0.0, 0.0, -27.833531945041752)
        }
        over "EgressRampStarboard"
        {
            custom double3 xformOp:rotateXYZ = (0.0, 180.0, 27.833531945041752)
        }
    }
    def Scope "Scenario"
    {
        def Scope "Mission" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_ramp_requirements.rhai@
        }
    }
}
