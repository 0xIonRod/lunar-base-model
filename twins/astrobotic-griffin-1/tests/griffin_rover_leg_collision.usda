#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Griffin1SurfaceOps" (
    prepend references = @twin://astrobotic-griffin-1/scenes/griffin_1_surface_ops.usda@</Griffin1SurfaceOps>
    documentation = "Production FLIP drives into a landed Griffin leg; structural proxies block the rover."
    prepend apiSchemas = ["LunCoEpochAPI"]
)
{
    double lunco:time:epochJd = 2461395.5
    def "Scenario" (
        active = false
    )
    {
    }
    def "FLIPPayloadAdapterJoint" (
        active = false
    )
    {
    }
    def "Lander"
    {
        double3 xformOp:translate = (0.0, 1.1, 0.0)
    }
    def "FLIP"
    {
        double3 xformOp:translate = (4.5, 1.47, 4.5)
        double3 xformOp:rotateXYZ = (0.0, 135.0, 0.0)
    }
    def Scope "RoverLegCollision"
    {
        def Scope "Observer" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_rover_leg_collision.rhai@
        }
    }
}
