#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Griffin1SurfaceOps" (
    prepend references = @twin://astrobotic-griffin-1/scenes/griffin_1_surface_ops.usda@</Griffin1SurfaceOps>
    kind = "assembly"
    documentation = "Production landed Griffin pilot hold/release acceptance. The observer commands semantic intent and measures delivered propulsion and native motion."
)
{
    over "Scenario"
    {
    }
    def Scope "EngineCommands"
    {
        def Scope "Observer" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_engine_commands.rhai@
        }
    }
}
