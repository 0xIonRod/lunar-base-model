#usda 1.0
(
    defaultPrim = "Griffin1SurfaceOps"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Griffin1SurfaceOps" (
    prepend references = @twin://astrobotic-griffin-1/scenes/griffin_1_surface_ops.usda@</Griffin1SurfaceOps>
)
{
    over "Scenario"
    {
        over "Mission"
        {
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_ramp_touchdown_geometry.rhai@
        }
    }
}
