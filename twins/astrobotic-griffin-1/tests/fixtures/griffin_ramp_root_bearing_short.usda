#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
    def Xform "RampRootBearing" (
        prepend references = @../../components/lander/griffin_ramp_root_bearing_visual.usda@</RootBearing>
    )
    {
        custom double3 xformOp:scale = (0.99, 1.0, 1.0)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
    def Scope "Scenario"
    {
        def Scope "Mission" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @../../scenarios/tests/griffin_ramp_root_bearing.rhai@
        }
    }
}
