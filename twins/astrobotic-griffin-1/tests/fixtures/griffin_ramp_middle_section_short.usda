#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
    def DistantLight "KeyLight"
    {
        float intensity = 0.550000011920929
        float angle = 0.5
        custom double3 xformOp:rotateXYZ = (-35.0, -35.0, 0.0)
        custom token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Scope "Scenario"
    {
        def Scope "Mission" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/scenarios/tests/griffin_ramp_middle_section.rhai@
        }
    }
    def Xform "RampMiddleSection" (
        prepend references = @twin://astrobotic-griffin-1/components/lander/griffin_ramp_middle_section_visual.usda@</RampSection>
    )
    {
        custom double3 xformOp:scale = (0.8, 1.0, 1.0)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
}
