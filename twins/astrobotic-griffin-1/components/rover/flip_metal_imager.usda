#usda 1.0
(
    defaultPrim = "METAL"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "METAL" (
    doc = "Downward-looking NASA Ames / Interlune METAL payload. The origin seats on the negative-X payload rail. LPSC 2026 paper 1370, figures 1 and 2. Mechanical envelope and adapter are study estimates."
)
{
    uniform token purpose = "render"

    def Scope "Looks"
    {
        def Material "Enclosure"
        {
            token outputs:surface.connect = </METAL/Looks/Enclosure/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.032, 0.037, 0.042)
                float inputs:metallic = 0.43
                float inputs:roughness = 0.37
                token outputs:surface
            }
        }

        def Material "MachinedMetal"
        {
            token outputs:surface.connect = </METAL/Looks/MachinedMetal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.53, 0.55, 0.56)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "OpticalGlass"
        {
            token outputs:surface.connect = </METAL/Looks/OpticalGlass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.026, 0.041, 0.05)
                float inputs:metallic = 0.4
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }

        def Material "Reflector"
        {
            token outputs:surface.connect = </METAL/Looks/Reflector/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.69, 0.65, 0.51)
                float inputs:metallic = 0.71
                float inputs:roughness = 0.23
                token outputs:surface
            }
        }
    }

    def Cube "MountWeb" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </METAL/Looks/MachinedMetal>
        custom bool physics:collisionEnabled = 0
        color3f[] primvars:displayColor = [(0.53, 0.55, 0.56)]
        double size = 1
        float3 xformOp:scale = (0.39, 0.02, 0.07)
        double3 xformOp:translate = (-0.165, 0.01, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "MountFlangeForward" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </METAL/Looks/MachinedMetal>
        custom bool physics:collisionEnabled = 0
        color3f[] primvars:displayColor = [(0.53, 0.55, 0.56)]
        double size = 1
        float3 xformOp:scale = (0.39, 0.024, 0.006)
        double3 xformOp:translate = (-0.165, 0.027, -0.032)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "MountFlangeAft" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </METAL/Looks/MachinedMetal>
        custom bool physics:collisionEnabled = 0
        color3f[] primvars:displayColor = [(0.53, 0.55, 0.56)]
        double size = 1
        float3 xformOp:scale = (0.39, 0.024, 0.006)
        double3 xformOp:translate = (-0.165, 0.027, 0.032)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "RailFastener0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.004
        rel material:binding = </METAL/Looks/Enclosure>
        custom bool physics:collisionEnabled = 0
        color3f[] primvars:displayColor = [(0.032, 0.037, 0.042)]
        double radius = 0.005
        double3 xformOp:translate = (0, 0.022, -0.022)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "RailFastener1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
