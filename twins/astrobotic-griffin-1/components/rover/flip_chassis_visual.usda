#usda 1.0
(
    defaultPrim = "FlipChassis"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "FlipChassis" (
    kind = "component"
)
{
    custom string lunco:visual:component = "flip_chassis"
    def Cube "LowerFrame" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2.0
        custom double3 xformOp:scale = (0.9, 0.06, 0.738)
        color3f[] primvars:displayColor = [(0.1599999964237213, 0.18000000715255737, 0.20000000298023224)]
        uniform token purpose = "render"
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
        custom double3 xformOp:translate = (0.0, 0.0, 0.0)
        custom rel material:binding = </FlipChassis/Looks/ExposedMetal>
    }
    def Cube "WhiteEquipmentBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2.0
        custom double3 xformOp:translate = (0.0, 0.258, 0.0)
        custom double3 xformOp:scale = (0.892, 0.198, 0.73)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.8299999833106995, 0.8399999737739563, 0.8399999737739563)]
        uniform token purpose = "render"
        bool physics:collisionEnabled = true
        custom rel material:binding = </FlipChassis/Looks/PaleEnclosure>
    }
    def Cube "FrontBumper" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2.0
        custom double3 xformOp:translate = (0.892, 0.06, 0.0)
        custom double3 xformOp:scale = (0.06, 0.06, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.10000000149011612, 0.11999999731779099, 0.14000000059604645)]
        uniform token purpose = "render"
        bool physics:collisionEnabled = true
        custom rel material:binding = </FlipChassis/Looks/ExposedMetal>
    }
    def Cube "PayloadDeck" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2.0
        custom double3 xformOp:translate = (0.0, 0.47600000000000003, 0.0)
        custom double3 xformOp:scale = (0.892, 0.02, 0.73)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.3400000035762787, 0.36000001430511475, 0.3799999952316284)]
        uniform token purpose = "render"
        bool physics:collisionEnabled = true
        custom rel material:binding = </FlipChassis/Looks/ExposedMetal>
    }
    def Cube "ServicePanel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 2.0
        custom double3 xformOp:translate = (0.0, 0.258, -0.7425)
        custom double3 xformOp:scale = (0.56, 0.125, 0.0125)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.36000001430511475, 0.38999998569488525, 0.41999998688697815)]
        uniform token purpose = "render"
        custom bool physics:collisionEnabled = false
        custom rel material:binding = </FlipChassis/Looks/ExposedMetal>
    }
    def Scope "Looks"
    {
        def Material "ExposedMetal"
        {
            token outputs:surface
            token outputs:surface.connect = </FlipChassis/Looks/ExposedMetal/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                custom token outputs:surface = ""
                custom color3f inputs:diffuseColor = (0.550000011920929, 0.5799999833106995, 0.6200000047683716)
                custom float inputs:metallic = 0.75
                custom float inputs:roughness = 0.41999998688697815
            }
        }
        def Material "PaleEnclosure"
        {
            token outputs:surface
            token outputs:surface.connect = </FlipChassis/Looks/PaleEnclosure/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                custom token outputs:surface = ""
                custom color3f inputs:diffuseColor = (0.8299999833106995, 0.8399999737739563, 0.8399999737739563)
                custom float inputs:metallic = 0.0
                custom float inputs:roughness = 0.5
            }
        }
    }
}
