#usda 1.0
(
    defaultPrim = "FlipSensorMast"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "FlipSensorMast" (
    kind = "component"
)
{
    custom string lunco:visual:component = "sensor_mast"
    def Cylinder "MastPost"
    {
        uniform token axis = "Y"
        float radius = 0.07
        float height = 0.70
        double3 xformOp:translate = (0.0, 1.45, -0.28)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.18, 0.20, 0.22)]
        uniform token purpose = "render"
    }
    def Cube "SensorHead"
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, 1.88, -0.28)
        double3 xformOp:scale = (0.40, 0.16, 0.24)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.12, 0.14, 0.17)]
        uniform token purpose = "render"
    }
    def Cylinder "SensorAntenna"
    {
        uniform token axis = "Y"
        float radius = 0.025
        float height = 0.28
        double3 xformOp:translate = (0.0, 2.10, -0.28)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.65, 0.67, 0.70)]
        uniform token purpose = "render"
    }
}
