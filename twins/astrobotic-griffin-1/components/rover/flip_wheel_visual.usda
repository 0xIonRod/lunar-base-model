#usda 1.0
(
    defaultPrim = "FlipWheel"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "FlipWheel" (
    kind = "component"
)
{
    custom string lunco:visual:component = "flip_wheel"
    def Cylinder "Tire"
    {
        uniform token axis = "X"
        float radius = 0.45
        float height = 0.30
        color3f[] primvars:displayColor = [(0.12, 0.13, 0.14)]
        uniform token purpose = "render"
    }
    def Cylinder "MetalHub"
    {
        uniform token axis = "X"
        float radius = 0.25
        float height = 0.33
        color3f[] primvars:displayColor = [(0.62, 0.65, 0.68)]
        uniform token purpose = "render"
    }
    def Cylinder "HubCap"
    {
        uniform token axis = "X"
        float radius = 0.10
        float height = 0.36
        color3f[] primvars:displayColor = [(0.22, 0.24, 0.27)]
        uniform token purpose = "render"
    }
}
