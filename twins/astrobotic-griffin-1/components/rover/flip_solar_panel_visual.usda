#usda 1.0
(
    defaultPrim = "FlipSolarPanel"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "FlipSolarPanel" (
    kind = "component"
)
{
    custom string lunco:visual:component = "flip_collapsible_solar_array"
    def Cube "WhiteBacksheet"
    {
        double size = 1.0
        double3 xformOp:scale = (1.65, 0.06, 1.05)
        color3f[] primvars:displayColor = [(0.78, 0.80, 0.82)]
        uniform token purpose = "render"
    }
    def Cube "BlueCells"
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.07, 0.0)
        double3 xformOp:scale = (1.42, 0.02, 0.82)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.04, 0.12, 0.30)]
        uniform token purpose = "render"
    }
    def Cube "FoldHinge"
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, 0.0, -1.08)
        double3 xformOp:scale = (1.70, 0.08, 0.08)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.18, 0.20, 0.22)]
        uniform token purpose = "render"
    }
}
