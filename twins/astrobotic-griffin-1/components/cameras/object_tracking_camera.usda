#usda 1.0
(
    defaultPrim = "ObjectTrackingCamera"
    upAxis = "Y"
    metersPerUnit = 1.0
)

# Reusable virtual pan/tilt camera rig. Instances set the tracked-object
# relationship, world-position input connections, and mount coordinates.
    def Xform "ObjectTrackingCamera" (
        doc = "Reusable virtual two-axis tracking camera rig with no rendered mast or camera body."
        kind = "component"
    )
    {
        custom double3 xformOp:translate = (0.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        custom rel lunco:tracking:trackedObject
        def Xform "GimbalBase" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            custom double3 xformOp:translate = (0.0, 10.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            bool physics:rigidBodyEnabled = true
            bool physics:kinematicEnabled = true
        }
        def Xform "PanYoke" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom double3 xformOp:translate = (0.0, 10.0, 0.0)
            quatf xformOp:orient = (0.9238795042037964, 0.0, 0.3826834261417389, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            bool physics:rigidBodyEnabled = true
            float physics:mass = 1.7999999523162842
            point3f physics:centerOfMass = (0.0, 0.0, 0.0)
            float3 physics:diagonalInertia = (0.07999999821186066, 0.10000000149011612, 0.07999999821186066)
        }
        def Xform "TiltHead" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom double3 xformOp:translate = (0.0, 10.0, 0.0)
            quatf xformOp:orient = (0.7641344666481018, 0.519280195236206, 0.31651484966278076, -0.21509291231632233)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            bool physics:rigidBodyEnabled = true
            float physics:mass = 1.2000000476837158
            point3f physics:centerOfMass = (0.0, 0.0, 0.0)
            float3 physics:diagonalInertia = (0.03500000014901161, 0.04500000178813934, 0.03500000014901161)
            def Camera "GriffinTrackingCamera" (
                prepend apiSchemas = ["LunCoCameraAPI"]
                prepend references = @lunco://components/cameras/lunar_surface_camera.usda@</LunarSurfaceCamera>
            )
            {
                uniform token lunco:cameraRole = "viewport"
                uniform token lunco:cameraPose = "authored"
                float focalLength = 35.0
                float horizontalAperture = 36.0
                float verticalAperture = 20.25
                float2 clippingRange = (0.1, 100000.0)
                double3 xformOp:translate = (0.0, 0.08, -0.39)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                custom rel lunco:tracking:trackedObject
                custom string documentation = "Reusable two-axis Modelica-tracked virtual observer camera."
            }
        }
        def PhysicsRevoluteJoint "CameraPanJoint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body0 = </ObjectTrackingCamera/GimbalBase>
            rel physics:body1 = </ObjectTrackingCamera/PanYoke>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0.0, 0.0, 0.0)
            point3f physics:localPos1 = (0.0, 0.0, 0.0)
            quatf physics:localRot0 = (1.0, 0.0, 0.0, 0.0)
            quatf physics:localRot1 = (1.0, 0.0, 0.0, 0.0)
            # The tracking controllers soft-limit at +/-168 degrees (2 degrees inside these stops).
            float physics:lowerLimit = -170.0
            float physics:upperLimit = 170.0
            bool physics:collisionEnabled = false
            token drive:angular:physics:type = "force"
            float drive:angular:physics:maxForce = 30.0
            float drive:angular:physics:stiffness = 45.0
            float drive:angular:physics:damping = 5.0
            float drive:angular:physics:targetPosition = 45.0
            float drive:angular:physics:targetVelocity = 0.0
            double inputs:angle = 0.7853981633974483
            double inputs:angle.connect = </ObjectTrackingCamera/Controller.outputs:pan_angle_rad>
        }
        def PhysicsRevoluteJoint "CameraTiltJoint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body0 = </ObjectTrackingCamera/PanYoke>
            rel physics:body1 = </ObjectTrackingCamera/TiltHead>
            uniform token physics:axis = "X"
            point3f physics:localPos0 = (0.0, 0.0, 0.0)
            point3f physics:localPos1 = (0.0, 0.0, 0.0)
            quatf physics:localRot0 = (1.0, 0.0, 0.0, 0.0)
            quatf physics:localRot1 = (1.0, 0.0, 0.0, 0.0)
            # The tracking controllers soft-limit at +/-83 degrees (2 degrees inside these stops).
            float physics:lowerLimit = -85.0
            float physics:upperLimit = 85.0
            bool physics:collisionEnabled = false
            token drive:angular:physics:type = "force"
            float drive:angular:physics:maxForce = 20.0
            float drive:angular:physics:stiffness = 35.0
            float drive:angular:physics:damping = 4.0
            float drive:angular:physics:targetPosition = 68.4000015258789
            float drive:angular:physics:targetVelocity = 0.0
            double inputs:angle = 1.1937604386677048
            double inputs:angle.connect = </ObjectTrackingCamera/Controller.outputs:tilt_angle_rad>
        }
        def Scope "Controller" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @twin://astrobotic-griffin-1/models/GriffinTrackingCamera.mo@
            uniform bool lunco:program:realtimeSafe = true
            double parameters:mount_x_m = 0.0
            double parameters:mount_y_m = 10.0
            double parameters:mount_z_m = 0.0
            double parameters:servo_tau_s = 0.18
            double parameters:max_pan_rate_rad_s = 1.047197551196598
            double parameters:max_tilt_rate_rad_s = 1.047197551196598
            double parameters:initial_pan_rad = 0.7853981633974483
            double parameters:initial_tilt_rad = 1.1937604386677048
            double inputs:target_x_m
            double inputs:target_y_m
            double inputs:target_z_m
            double outputs:pan_angle_rad = 0.7853981633974483
            double outputs:tilt_angle_rad = 1.1937604386677048
            double outputs:target_range_m = 53.777
            double outputs:tracking_valid = 1.0
        }
    }
