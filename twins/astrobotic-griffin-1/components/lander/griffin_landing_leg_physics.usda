#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    documentation = "Shared lumped moving-leg body. The integrated vehicle supplies the sourced mount, mass and nominal foot-hub COM. Visual and source-derived contact geometry belong to its named assembly children. Mass distribution and inertia remain uncalibrated study proxies."
)
{
    float physics:mass = 180.0
    float3 physics:centerOfMass = (0.0, -1.2599999904632568, 0.0)
    float3 physics:diagonalInertia = (18.0, 2.5, 18.0)
    custom string lunco:part:role = "Griffin-1 landing leg module"
    custom string lunco:part:interface = "deck mount to circular touchdown pad; reusable four-way instance"
    custom string lunco:provenance:source = "Twin-authored study geometry; public flight ICD unavailable"
    bool physxRigidBody:enableCCD = true
}
