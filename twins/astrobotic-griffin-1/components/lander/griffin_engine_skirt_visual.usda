#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
    def Xform "EngineSkirt" (
        kind = "component"
    )
    {
        custom string lunco:visual:component = "engine_skirt"
