#usda 1.0
(
    defaultPrim = "EgressRamp"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
}

def Xform "EgressRamp" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "LunCoCatalogAPI"]
    kind = "component"
)
{
    custom string lunco:part:role = "egress_ramp"
    float physics:mass = 95.0
    point3f physics:centerOfMass = (1.4500000476837158, -0.07999999821186066, 0.0)
    float3 physics:diagonalInertia = (80.0, 140.0, 80.0)
    custom string lunco:component_role = "deployable egress ramp"
    custom string lunco:mechanism = "hinged side ramp with dual edge rails"
    custom float lunco:deployment_angle_limit_rad = 0.5799999833106995
    custom string lunco:provenance:source = "https://www.astrobotic.com/astrobotic-griffin-lander-and-nasas-viper-moon-rover-complete-complex-test-drives/"
    uniform bool lunco:spawnable = true
    def Cube "Surface" (
        prepend apiSchemas = "PhysicsCollisionAPI"
    )
    {
        custom double3 xformOp:translate = (1.95, -0.1, 0.0)
        custom token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        custom double3 xformOp:scale = (1.95, 0.08, 1.05)
        double size = 1.95
        bool physics:collisionEnabled = true
        color3f[] primvars:displayColor = [(0.4699999988079071, 0.5, 0.5199999809265137)]
        custom string lunco:part:role = "ramp_surface"
    }
    def Cube "EdgeRail" (
        prepend apiSchemas = "PhysicsCollisionAPI"
    )
    {
        custom double3 xformOp:translate = (1.95, 0.16, 0.97)
        custom token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        custom double3 xformOp:scale = (1.95, 0.1, 0.08)
        double size = 1.0
        bool physics:collisionEnabled = true
        color3f[] primvars:displayColor = [(0.6399999856948853, 0.6600000262260437, 0.6899999976158142)]
        custom string lunco:part:role = "ramp_outer_rail"
    }
    def Cube "EdgeRailInner" (
        prepend apiSchemas = "PhysicsCollisionAPI"
    )
    {
        custom double3 xformOp:translate = (1.95, 0.16, -0.97)
        custom token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        custom double3 xformOp:scale = (1.95, 0.1, 0.08)
        double size = 1.0
        bool physics:collisionEnabled = true
        color3f[] primvars:displayColor = [(0.6399999856948853, 0.6600000262260437, 0.6899999976158142)]
        custom string lunco:part:role = "ramp_inner_rail"
    }
    def Cube "HingeBlock" (
        prepend apiSchemas = "PhysicsCollisionAPI"
    )
    {
        custom double3 xformOp:translate = (0.0, 0.0, 0.0)
        custom token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        custom double3 xformOp:scale = (0.32, 0.18, 0.82)
        double size = 1.0
        bool physics:collisionEnabled = true
        color3f[] primvars:displayColor = [(0.2800000011920929, 0.30000001192092896, 0.33000001311302185)]
        custom string lunco:part:role = "ramp_hinge"
    }
    def Cylinder "MountSocket" (
        prepend apiSchemas = "PhysicsCollisionAPI"
    )
    {
        custom double3 xformOp:translate = (0.0, 0.22, 0.0)
        custom token[] xformOpOrder = ["xformOp:translate"]
        uniform token axis = "Y"
        double radius = 0.12
        double height = 0.45
        bool physics:collisionEnabled = false
        color3f[] primvars:displayColor = [(0.6399999856948853, 0.6600000262260437, 0.6899999976158142)]
        custom string lunco:part:role = "ramp_mount_socket"
    }
}
