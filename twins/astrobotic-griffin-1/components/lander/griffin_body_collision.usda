    custom string lunco:provenance:source = "Twin-authored Griffin study geometry; public flight ICD unavailable"
    def Cube "BodyCollisionProxy" (
        prepend apiSchemas = "PhysicsCollisionAPI"
    )
    {
        double size = 1.0
