#usda 1.0
(
    defaultPrim = "GriffinBody"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "GriffinBody" (
    kind = "component"
    prepend apiSchemas = "MaterialBindingAPI"
)
{
