#usda 1.0
(
    defaultPrim = "EngineBell"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "EngineBell" (
    kind = "component"
)
{
    def Cone "Bell"
    {
        uniform token axis = "Y"
        float radius1 = 0.1599999964237213
        float radius2 = 0.3400000035762787
        float height = 0.5199999809265137
        color3f[] primvars:displayColor = [(0.20000000298023224, 0.2199999988079071, 0.25)]
        uniform token purpose = "render"
        float radius = 0.3400000035762787
    }
    def Cylinder "Throat"
    {
        uniform token axis = "Y"
        float radius = 0.11999999731779099
        float height = 0.1599999964237213
        double3 xformOp:translate = (0.0, 0.28, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.47999998927116394, 0.5, 0.5400000214576721)]
        uniform token purpose = "render"
    }
    def Cone "Flame" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 1.0
        double height = 1.0
        double3 xformOp:translate = (0.0, -2.26, 0.0)
        double3 xformOp:rotateXYZ = (180.0, 0.0, 0.0)
        double3 xformOp:scale = (0.55, 4.0, 0.55)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        uniform token purpose = "render"
        float[] primvars:displayOpacity = [0.42]
        uniform bool doubleSided = true
        bool lunco:surface:additive = false
        bool physics:collisionEnabled = false
        bool primvars:doNotCastShadows = true
        float inputs:throttle
        float inputs:plume_length_fraction
    }
    def Cone "FlameCore" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 1.0
        double height = 1.0
        double3 xformOp:translate = (0.0, -2.26, 0.0)
        double3 xformOp:rotateXYZ = (180.0, 0.0, 0.0)
        double3 xformOp:scale = (0.27, 4.0, 0.27)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        uniform token purpose = "render"
        float[] primvars:displayOpacity = [0.90]
        uniform bool doubleSided = true
        bool lunco:surface:additive = true
        bool physics:collisionEnabled = false
        bool primvars:doNotCastShadows = true
        float inputs:throttle
        float inputs:plume_length_fraction

        def SphereLight "PlumeLight" (
            prepend apiSchemas = ["ShadowAPI", "LunCoLightAPI"]
        )
        {
            float inputs:intensity
            bool inputs:shadow:enable = false
            float inputs:radius
            color3f inputs:color = (1.0, 0.4, 0.04)
            float lunco:light:range = 25.0
            float inputs:light_intensity
            float inputs:light_radius
        }
    }
}
