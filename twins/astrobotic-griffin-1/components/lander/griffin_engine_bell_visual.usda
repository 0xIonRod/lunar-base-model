#usda 1.0
(
    defaultPrim = "EngineBell"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "EngineBell" (
    kind = "component"
)
{
    custom string lunco:visual:component = "main_engine_bell"
    def Cone "Bell"
    {
        uniform token axis = "Y"
        float radius1 = 0.16
        float radius2 = 0.34
        float height = 0.52
        color3f[] primvars:displayColor = [(0.20, 0.22, 0.25)]
        uniform token purpose = "render"
    }
    def Cylinder "Throat"
    {
        uniform token axis = "Y"
        float radius = 0.12
        float height = 0.16
        double3 xformOp:translate = (0.0, 0.28, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.48, 0.50, 0.54)]
        uniform token purpose = "render"
    }
}
