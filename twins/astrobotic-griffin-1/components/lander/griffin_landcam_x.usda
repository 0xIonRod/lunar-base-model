#usda 1.0
(
    defaultPrim = "LandCamX"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "LandCamX" (
    doc = "ESA LandCam-X landing-imagery payload. Flight-view study of the uncovered OIP demonstrator. The adapter and downward cant are reconstruction estimates."
)
{
    uniform token purpose = "render"

    def Scope "Looks"
    {
        def Material "MachinedMetal"
        {
            token outputs:surface.connect = </LandCamX/Looks/MachinedMetal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.58, 0.6)
                float inputs:metallic = 0.76
                float inputs:roughness = 0.27
                token outputs:surface
            }
        }

        def Material "BaffleFinish"
        {
            token outputs:surface.connect = </LandCamX/Looks/BaffleFinish/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.53, 0.46, 0.28)
                float inputs:metallic = 0.72
                float inputs:roughness = 0.34
                token outputs:surface
            }
        }

        def Material "BlueHardware"
        {
            token outputs:surface.connect = </LandCamX/Looks/BlueHardware/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.026, 0.083, 0.19)
                float inputs:metallic = 0.64
                float inputs:roughness = 0.29
                token outputs:surface
            }
        }

        def Material "OpticalBlack"
        {
            token outputs:surface.connect = </LandCamX/Looks/OpticalBlack/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.021, 0.025, 0.032)
                float inputs:metallic = 0.25
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "OpticalGlass"
        {
            token outputs:surface.connect = </LandCamX/Looks/OpticalGlass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.028, 0.055, 0.07)
                float inputs:metallic = 0.48
                float inputs:roughness = 0.14
                token outputs:surface
            }
        }
    }

    def Cube "RailShoe" (
