        double size = 1.0
        double3 xformOp:translate = (1.65, 0.16, 0.82)
        double3 xformOp:scale = (1.85, 0.14, 0.07)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.38, 0.40, 0.43)]
        uniform token purpose = "render"
    }
    def Cube "InnerRail"
    {
        double size = 1.0
        double3 xformOp:translate = (1.65, 0.16, -0.82)
        double3 xformOp:scale = (1.85, 0.14, 0.07)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.38, 0.40, 0.43)]
        uniform token purpose = "render"
    }
    def Cube "SupportArm"
    {
        double size = 1.0
