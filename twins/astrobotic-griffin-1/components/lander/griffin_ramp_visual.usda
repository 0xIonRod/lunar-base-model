#usda 1.0
(
    defaultPrim = "EgressRamp"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "EgressRamp" (
    kind = "assembly"
)
{
    custom token lunco:component:role = "Griffin three-section rover egress ramp"
    def Xform "DeckSection" (
        references = @twin://astrobotic-griffin-1/components/lander/griffin_ramp_section_visual.usda@</RampSection>
    ) { }
    def Xform "MiddleSection" (
        references = @twin://astrobotic-griffin-1/components/lander/griffin_ramp_section_visual.usda@</RampSection>
    )
    {
        double3 xformOp:translate = (4.076201667, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "ToeSection" (
        references = @twin://astrobotic-griffin-1/components/lander/griffin_ramp_toe_section_visual.usda@</RampToeSection>
    )
    {
        double3 xformOp:translate = (8.152403334, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
