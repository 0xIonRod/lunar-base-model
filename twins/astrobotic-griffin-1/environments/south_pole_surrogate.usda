#usda 1.0
(
    defaultPrim = "SouthPoleSurrogate"
    upAxis = "Y"
    metersPerUnit = 1
)

# Deterministic, labelled environment for surface-operations studies. It is
# intentionally not a geographic reconstruction of Nobile Crater.
def Xform "SouthPoleSurrogate" (
    kind = "assembly"
    doc = "Procedural South-Pole terrain surrogate; not a validated Nobile Crater DEM."
)
{
    custom string lunco:terrain:source = "procedural surrogate"
    custom string lunco:terrain:site = "Nobile Crater region, coordinates unresolved"
    custom string lunco:terrain:confidence = "low"

    def Scope "PhysicsMaterials"
    {
        def Material "RegolithSurrogate" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.65
            float physics:staticFriction = 0.80
            float physics:restitution = 0.0
            token physxMaterial:frictionCombineMode = "min"
        }
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        token lunco:terrain:surfaceRole = "flat-site"
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.13, 0.125, 0.12)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SouthPoleSurrogate/PhysicsMaterials/RegolithSurrogate>
    }

    # Low visual berms make the surrogate read as a cratered site without
    # pretending to be a DEM or changing the collision plane.
    def Scope "VisualBerms"
    {
        def Cylinder "BermEast"
        {
            float radius = 16.0
            float height = 0.35
            double3 xformOp:translate = (28.0, 0.15, 12.0)
            color3f[] primvars:displayColor = [(0.18, 0.17, 0.16)]
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cylinder "BermWest"
        {
            float radius = 12.0
            float height = 0.25
            double3 xformOp:translate = (-24.0, 0.1, -18.0)
            color3f[] primvars:displayColor = [(0.18, 0.17, 0.16)]
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
