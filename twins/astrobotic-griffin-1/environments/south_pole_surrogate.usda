#usda 1.0
(
    defaultPrim = "SouthPoleSurrogate"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SouthPoleSurrogate" (
    kind = "assembly"
    doc = "Procedural South-Pole terrain surrogate; not a validated Nobile Crater DEM."
)
{
    custom string lunco:terrain:source = "LROC NAC DTM NOBILE03 (4 m/pixel polar-stereographic source; locally reprojected)"
    custom string lunco:terrain:site = "Nobile regional study anchor; exact Griffin touchdown coordinate unresolved"
    custom string lunco:terrain:confidence = "source-backed regional relief; simulator-selected center and vertical datum"
    def Scope "PhysicsMaterials"
    {
        def Material "RegolithSurrogate" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6499999761581421
            float physics:staticFriction = 0.800000011920929
            float physics:restitution = 0.0
            token physxMaterial:frictionCombineMode = "min"
        }
    }
    def Scope "Looks"
    {
        def Material "RegolithSurface"
        {
            token outputs:surface
            token outputs:surface.connect = </SouthPoleSurrogate/Looks/RegolithSurface/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                color3f inputs:albedo = (0.12999999523162842, 0.12999999523162842, 0.12999999523162842)
                token outputs:surface
                uniform asset info:wesl:sourceAsset = @lunco://shaders/terrain_layered.wesl@
                asset info:wesl:vertexAsset = @lunco://shaders/terrain_geomorph.wesl@
                custom asset inputs:albedo_map = @terrain/nobile03/materials/textures/albedo.png@
                custom float inputs:weight_albedo = 1.0
                custom float inputs:micro_albedo = 0.20000000298023224
                custom float inputs:macro_clump_scale = 4.0
                custom float inputs:macro_bump = 0.014999999664723873
                custom float inputs:micro_bump = 0.001500000013038516
            }
        }
    }
    def Xform "Terrain" (
        prepend apiSchemas = ["LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        string lunco:assetMode = "layered"
        custom string lunco:terrain:source = "LROC NAC DTM NOBILE03 (4 m/pixel polar-stereographic source; locally reprojected)"
        custom string lunco:terrain:site = "Nobile regional study anchor; exact Griffin touchdown coordinate unresolved"
        custom string lunco:terrain:confidence = "source-backed regional relief; simulator-selected center and vertical datum"
        double lunco:anchor:lat = -84.72672255
        double lunco:anchor:lon = 29.14428685
        double lunco:anchor:height = 5187.322
        int lunco:anchor:body = 301
        custom string lunco:terrain:horizontalDatum = "MOON_ME; local ENU (+X east, +Y up, -Z north)"
        custom string lunco:terrain:verticalDatum = "LROC source datum normalized by -5187.322 m into scene-local height"
        custom asset lunco:terrain:processedAsset = @terrain/nobile03@
        rel material:binding = </SouthPoleSurrogate/Looks/RegolithSurface>
        def Xform "dem" (
            prepend apiSchemas = ["LunCoTerrainLayerAPI"]
        )
        {
            uniform token lunco:layer = "dem"
            asset lunco:layer:demSource = @terrain/nobile03@
            float lunco:layer:windowM = 512.0
            int lunco:layer:targetRes = 129
            bool lunco:layer:lodViz = true
            bool lunco:layer:colliderRing = true
            int lunco:layer:colliderDepth = 4
            int lunco:layer:colliderResolution = 65
        }
    }
    def Plane "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
        active = false
    )
    {
        uniform token lunco:terrain:surfaceRole = "flat-site"
        double width = 2.0
        double length = 2.0
        uniform token axis = "Y"
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        double3 xformOp:scale = (100.0, 1.0, 100.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.12999999523162842, 0.125, 0.11999999731779099)]
        bool physics:collisionEnabled = true
        custom rel material:binding:physics = </SouthPoleSurrogate/PhysicsMaterials/RegolithSurrogate>
    }
}
