#usda 1.0
(
    defaultPrim = "LunarSurface"
    documentation = "Twin-local lunar surface preamble: gravity, sun, and default contact material."
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "LunarSurface"
{
    custom string lunco:lighting:status = "single authoritative low-elevation polar sun; shared by Griffin and FLIP"
    custom string lunco:lighting:source = "scene refinement of lunco://lighting/sun.usda; no duplicate mission light"
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0.0, -1.0, 0.0)
        float physics:gravityMagnitude = 1.6200000047683716
    }
    def DistantLight "Sun" (
        prepend references = @lunco://lighting/sun.usda@</Sun>
    )
    {
        double3 xformOp:rotateXYZ = (-8.14, 95.72, 0.0)
    }
    def Scope "PhysicsMaterials"
    {
        def Material "Friction_1_0" (
            prepend apiSchemas = "PhysicsMaterialAPI"
        )
        {
            float physics:dynamicFriction = 1.0
            float physics:staticFriction = 1.0
        }
    }
}
