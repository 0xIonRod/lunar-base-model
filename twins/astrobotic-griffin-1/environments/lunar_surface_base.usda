#usda 1.0
(
    defaultPrim = "LunarSurface"
    doc = "Twin-local lunar surface preamble: gravity, sun, and default contact material."
    metersPerUnit = 1
    upAxis = "Y"
)

# The installed LunCoSim bundle does not guarantee that the shared
# lunco://scenes/base/lunar_surface.usda catalog asset is present. Keep this
# small shared preamble inside the Griffin twin so the scene is portable while
# preserving one physics scene and one default contact material.
def Xform "LunarSurface"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 1.62
    }

    def DistantLight "Sun" (
        prepend references = @lunco://lighting/sun.usda@</Sun>
    )
    {
    }

    def Scope "PhysicsMaterials"
    {
        def Material "Friction_1_0" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.0
            float physics:staticFriction = 1.0
        }
    }
}
