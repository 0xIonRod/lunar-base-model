#usda 1.0
(
    defaultPrim = "GriffinBody"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "GriffinBody" (
    kind = "component"
    prepend apiSchemas = "MaterialBindingAPI"
)
{
    custom string lunco:part:role = "Griffin-1 MLI-wrapped box-section body"
    custom string lunco:provenance:source = "Twin-authored Griffin study geometry; public flight ICD unavailable"
    custom string lunco:material:outer = "gold multilayer insulation blanket"
    def Scope "Looks"
    {
        def Material "MliFoil_Mat"
        {
            token outputs:surface
            token outputs:surface.connect = </GriffinBody/Looks/MliFoil_Mat/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/mli_foil.wgsl@
                color3f inputs:foil_color = (0.8299999833106995, 0.6200000047683716, 0.18000000715255737)
                color3f inputs:shade_color = (0.44999998807907104, 0.30000001192092896, 0.07999999821186066)
                float inputs:crinkle = 26.0
                float inputs:facet_depth = 0.550000011920929
                float inputs:sheen = 0.8500000238418579
                float inputs:v_scale = 0.1899999976158142
                token outputs:surface
            }
        }
    }
    def Mesh "MliWrappedBus" (
