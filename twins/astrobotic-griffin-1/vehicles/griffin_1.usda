#usda 1.0
(
    defaultPrim = "Griffin1"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Griffin1" (
    documentation = "A powered-descent lander. Possess it to take the stick: Space thrusts, WASD tilts, Q/E turns. It has no guidance of its own — a scene composes that on."
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "LunCoCatalogAPI", "LunCoProgramAPI", "LunCoUiSchemaAPI", "MaterialBindingAPI"]
    prepend references = @lunco://components/avionics/obc_lander.usda@</LanderOBC>
)
{
    rel material:binding:physics = </Griffin1/PhysicsMaterials/LandingPadSlide>
    bool lunco:ui:schemaNode = false
    string lunco:ui:schemaRole = "Tracks attitude · applies commands"
    custom float lunco:payload_class_kg = 625.0
    custom string lunco:payload_class_status = "not a public flight ICD; Griffin study envelope"
    custom string lunco:parameter_status = "public configuration plus explicit simulator study values; flight ICD TBD"
    custom string lunco:provenance:source = "https://www.astrobotic.com/griffin"
    custom string lunco:collision:contract = "named proxy colliders own contact; render-only geometry is non-colliding"
    custom string lunco:egress = "FLIP payload adapter with port and starboard hinged ramps"
    uniform bool lunco:spawnable = true
    bool physics:rigidBodyEnabled = true
    float physxRigidBody:linearDamping = 0.0
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:sourceAsset = @lunco://models/Lander.mo@
    uniform bool lunco:program:realtimeSafe = true
    float inputs:spool_tau = 0.3499999940395355
    float inputs:authority_filter_tau_s = 0.019999999552965164
    float inputs:minimum_time_constant_s = 0.0000009999999974752427
    float inputs:authority_initial = 0.6000000238418579
    float inputs:command_lower_bound = 0.0
    float inputs:command_upper_bound = 1.0
    float inputs:landing_engine_cutoff = 0.0
    float inputs:ang_authority = 0.6000000238418579
    float inputs:command_tilt_limit_rad = 0.3499999940395355
    float inputs:attitude_hold = 1.0
    float inputs:hold_kp = 4.0 (
        customData = {
    double max = 12.0
    double min = 0.0
    string unit = "rad/s2"
}
    )
    float inputs:hold_kd = 6.0 (
        customData = {
    double max = 12.0
    double min = 0.0
    string unit = "rad/s"
}
    )
    float inputs:mass
    float inputs:mass.connect = </Griffin1/MainPropulsion.outputs:vehicle_mass_kg>
    float inputs:com_x
    float inputs:com_x.connect = </Griffin1/MainPropulsion.outputs:vehicle_com_x_m>
    float inputs:com_y
    float inputs:com_y.connect = </Griffin1/MainPropulsion.outputs:vehicle_com_y_m>
    float inputs:com_z
    float inputs:com_z.connect = </Griffin1/MainPropulsion.outputs:vehicle_com_z_m>
    float inputs:piloted
    float inputs:piloted.connect = </Griffin1.outputs:piloted>
    float inputs:gyro_x
    float inputs:gyro_x.connect = </Griffin1/IMU.outputs:gyro_x>
    float inputs:gyro_y
    float inputs:gyro_y.connect = </Griffin1/IMU.outputs:gyro_y>
    float inputs:gyro_z
    float inputs:gyro_z.connect = </Griffin1/IMU.outputs:gyro_z>
    float inputs:attitude_error_x
    float inputs:attitude_error_x.connect = </Griffin1/AttitudeReference.outputs:error_x>
    float inputs:attitude_error_y
    float inputs:attitude_error_y.connect = </Griffin1/AttitudeReference.outputs:error_y>
    float inputs:attitude_error_z
    float inputs:attitude_error_z.connect = </Griffin1/AttitudeReference.outputs:error_z>
    float inputs:upright_axis_y
    float inputs:upright_axis_y.connect = </Griffin1/AttitudeReference.outputs:estimated_up_y>
    float inputs:leg_force_px
    float inputs:leg_force_px.connect = </Griffin1/LegPX.outputs:contact_force>
    float inputs:leg_force_nx
    float inputs:leg_force_nx.connect = </Griffin1/LegNX.outputs:contact_force>
    float inputs:leg_force_pz
    float inputs:leg_force_pz.connect = </Griffin1/LegPZ.outputs:contact_force>
    float inputs:leg_force_nz
    float inputs:leg_force_nz.connect = </Griffin1/LegNZ.outputs:contact_force>
    float inputs:leg_contact_px
    float inputs:leg_contact_px.connect = </Griffin1/LegPX.outputs:contact>
    float inputs:leg_contact_nx
    float inputs:leg_contact_nx.connect = </Griffin1/LegNX.outputs:contact>
    float inputs:leg_contact_pz
    float inputs:leg_contact_pz.connect = </Griffin1/LegPZ.outputs:contact>
    float inputs:leg_contact_nz
    float inputs:leg_contact_nz.connect = </Griffin1/LegNZ.outputs:contact>
    float inputs:leg_displacement_px
    float inputs:leg_displacement_px.connect = </Griffin1/LegPX_Spring.outputs:displacement>
    float inputs:leg_displacement_nx
    float inputs:leg_displacement_nx.connect = </Griffin1/LegNX_Spring.outputs:displacement>
    float inputs:leg_displacement_pz
    float inputs:leg_displacement_pz.connect = </Griffin1/LegPZ_Spring.outputs:displacement>
    float inputs:leg_displacement_nz
    float inputs:leg_displacement_nz.connect = </Griffin1/LegNZ_Spring.outputs:displacement>
    float inputs:leg_velocity_px
    float inputs:leg_velocity_px.connect = </Griffin1/LegPX_Spring.outputs:velocity>
    float inputs:leg_velocity_nx
    float inputs:leg_velocity_nx.connect = </Griffin1/LegNX_Spring.outputs:velocity>
    float inputs:leg_velocity_pz
    float inputs:leg_velocity_pz.connect = </Griffin1/LegPZ_Spring.outputs:velocity>
    float inputs:leg_velocity_nz
    float inputs:leg_velocity_nz.connect = </Griffin1/LegNZ_Spring.outputs:velocity>
    float inputs:navigation_velocity_x
    float inputs:navigation_velocity_x.connect = </Griffin1.outputs:velocity_x>
    float inputs:navigation_velocity_y
    float inputs:navigation_velocity_y.connect = </Griffin1.outputs:velocity_y>
    float inputs:navigation_velocity_z
    float inputs:navigation_velocity_z.connect = </Griffin1.outputs:velocity_z>
    string lunco:ui:surfaceId = "vehicle-control-left"
    string lunco:ui:visibilityMode = "possessed"
    double inputs:hold_torque_limit_nm = 277.1778424205232
    float outputs:throttle = 0.0
    custom double inputs:controller_inertia_xx
    double inputs:controller_inertia_xx.connect = </Griffin1/MainPropulsion.outputs:vehicle_inertia_xx_kg_m2>
    custom double inputs:inertia_xx
    double inputs:inertia_xx.connect = </Griffin1/MainPropulsion.outputs:vehicle_inertia_xx_kg_m2>
    custom double inputs:controller_inertia_yy
    double inputs:controller_inertia_yy.connect = </Griffin1/MainPropulsion.outputs:vehicle_inertia_yy_kg_m2>
    custom double inputs:inertia_yy
    double inputs:inertia_yy.connect = </Griffin1/MainPropulsion.outputs:vehicle_inertia_yy_kg_m2>
    custom double inputs:controller_inertia_zz
    double inputs:controller_inertia_zz.connect = </Griffin1/MainPropulsion.outputs:vehicle_inertia_zz_kg_m2>
    custom double inputs:inertia_zz
    double inputs:inertia_zz.connect = </Griffin1/MainPropulsion.outputs:vehicle_inertia_zz_kg_m2>
    float physics:mass = 4000.0
    point3f physics:centerOfMass = (0.0, 0.6949999928474426, 0.0)
    float3 physics:diagonalInertia = (7279.60009765625, 7695.0, 7279.60009765625)
    custom double inputs:control_powered
    double inputs:control_powered.connect = </Griffin1/ElectricalPower.outputs:avionics_powered>
    def Scope "PhysicsMaterials"
    {
        def Material "LandingPadSlide" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4000000059604645
            float physics:staticFriction = 0.5
            float physics:restitution = 0.0
            token physxMaterial:frictionCombineMode = "min"
        }
    }
    def Scope "MainPropulsion" (
        prepend apiSchemas = ["CollectionAPI:components", "LunCoUiSchemaAPI"]
    )
    {
        bool lunco:ui:schemaNode = true
        string ui:displayName = "Main engine"
        int lunco:ui:schemaColumn = 2
        int lunco:ui:schemaRow = 1
        string lunco:ui:schemaRole = "Throttle in · downward braking"
        uniform token collection:components:expansionRule = "explicitOnly"
        custom rel collection:components:includes = [</Griffin1/MainPropulsion/FuelTank>, </Griffin1/MainPropulsion/OxidizerTank>, </Griffin1/MainPropulsion/NozzleDesign>, </Griffin1/MainPropulsion/PropellantStatus>, </Griffin1/MainPropulsion/Engine01>, </Griffin1/MainPropulsion/Engine01Plume>, </Griffin1/MainPropulsion/Engine02>, </Griffin1/MainPropulsion/Engine02Plume>, </Griffin1/MainPropulsion/Engine03>, </Griffin1/MainPropulsion/Engine03Plume>, </Griffin1/MainPropulsion/Engine04>, </Griffin1/MainPropulsion/Engine04Plume>, </Griffin1/MainPropulsion/Engine05>, </Griffin1/MainPropulsion/Engine05Plume>, </Griffin1/MainPropulsion/Engine06>, </Griffin1/MainPropulsion/Engine06Plume>, </Griffin1/MainPropulsion/Engine07>, </Griffin1/MainPropulsion/Engine07Plume>]
        float inputs:rcs_fuel_mass_flow_kgs
        float inputs:rcs_fuel_mass_flow_kgs.connect = </Griffin1/AttitudePropulsion.outputs:fuel_mass_flow_kgs>
        float inputs:rcs_oxidizer_mass_flow_kgs
        float inputs:rcs_oxidizer_mass_flow_kgs.connect = </Griffin1/AttitudePropulsion.outputs:oxidizer_mass_flow_kgs>
        float outputs:propellant_mass
        float outputs:propellant_mass.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:propellant_mass_kg>
        float outputs:propellant_fraction
        float outputs:propellant_fraction.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:propellant_fraction>
        float outputs:propellant_used
        float outputs:propellant_used.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:propellant_used_kg>
        float outputs:low_fuel
        float outputs:low_fuel.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:low_fuel>
        float outputs:depleted
        float outputs:depleted.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:depleted>
        float outputs:vehicle_mass_kg
        float outputs:vehicle_mass_kg.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_mass_kg>
        float outputs:vehicle_com_x_m
        float outputs:vehicle_com_x_m.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_com_x_m>
        float outputs:vehicle_com_y_m
