#usda 1.0
(
    defaultPrim = "Griffin1"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Griffin1" (
    prepend references = @lunco://vessels/landers/descent_lander.usda@</DescentLander>
    kind = "assembly"
    documentation = "Astrobotic Griffin-1 surface Twin wrapper around the reusable powered-descent lander."
)
{
    custom string lunco:mission:id = "M02"
    custom string lunco:mission:vehicle = "Astrobotic Griffin Mission One"
    custom string lunco:mission:operator = "Voyager Technologies / Astrobotic"
    custom string lunco:mission:rover = "Astrolab FLIP"
    custom string lunco:mission:landing_region = "Nobile Crater area, lunar South Pole"
    custom string lunco:configuration = "polar prototype; four legs; isogrid deck; side-mounted solar arrays"
    custom float lunco:payload_class_kg = 625.0
    custom string lunco:payload_class_status = "MoonDAO backlog prototype requirement; not a public Griffin flight value"
    custom string lunco:egress = "two side ramps; physical revolute hinges; top-deck payload adapter"
    custom string lunco:parameter_status = "Griffin as-built data pending; prototype geometry and payload class are explicit study assumptions"
    custom string lunco:provenance:source = "NASA and Astrobotic public mission updates; see research/griffin_1_assumptions.md"
    custom string lunco:provenance:ownership = "Astrobotic announced an agreement to join Voyager Technologies; Griffin-1 mission identity remains unchanged"
    custom string lunco:collision:contract = "external struts, pads, panels, deck, ramps, and rails are solid; FLIP route stays in the leg-clear center corridor"
    def Xform "IsogridDeck"
    {
        double3 xformOp:translate = (0.0, 1.72, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "DeckPlate" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:scale = (3.15, 0.08, 3.15)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            color3f[] primvars:displayColor = [(0.47999998927116394, 0.5, 0.5199999809265137)]
            bool physics:collisionEnabled = true
            rel material:binding:physics = </Griffin1/PhysicsMaterials/LandingPadSlide>
        }
        def Cube "Grid_Diagonal_PX"
        {
            double size = 1.0
            double3 xformOp:scale = (4.1, 0.035, 0.035)
            double3 xformOp:rotateXYZ = (0.0, 45.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:rotateXYZ"]
            color3f[] primvars:displayColor = [(0.3199999928474426, 0.3400000035762787, 0.36000001430511475)]
            bool physics:collisionEnabled = false
        }
        def Cube "Grid_Diagonal_NX"
        {
            double size = 1.0
            double3 xformOp:scale = (4.1, 0.035, 0.035)
            double3 xformOp:rotateXYZ = (0.0, -45.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:rotateXYZ"]
            color3f[] primvars:displayColor = [(0.3199999928474426, 0.3400000035762787, 0.36000001430511475)]
            bool physics:collisionEnabled = false
        }
        def Cube "Grid_Crossbar_X"
        {
            double size = 1.0
            double3 xformOp:scale = (3.0, 0.035, 0.035)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            color3f[] primvars:displayColor = [(0.3199999928474426, 0.3400000035762787, 0.36000001430511475)]
            bool physics:collisionEnabled = false
        }
        def Cube "Grid_Crossbar_Z"
        {
            double size = 1.0
            double3 xformOp:scale = (0.035, 0.035, 3.0)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            color3f[] primvars:displayColor = [(0.3199999928474426, 0.3400000035762787, 0.36000001430511475)]
            bool physics:collisionEnabled = false
        }
    }
    def Xform "PayloadAdapter"
