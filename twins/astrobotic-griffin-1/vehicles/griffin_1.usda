    def PhysicsRevoluteJoint "EgressRampPortHinge"
    {
        rel physics:body0 = </Griffin1>
        rel physics:body1 = </Griffin1/EgressRampPort>
        uniform token physics:axis = "Z"
        point3f physics:localPos0 = (2.299999952316284, 1.9500000476837158, 0.0)
        point3f physics:localPos1 = (-2.299999952316284, 0.0, 0.0)
        float physics:lowerLimit = -50.0
