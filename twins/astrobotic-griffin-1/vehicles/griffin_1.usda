#usda 1.0
(
    defaultPrim = "Griffin1"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Griffin1" (
    documentation = "A powered-descent lander. Possess it to take the stick: Space thrusts, WASD tilts, Q/E turns. It has no guidance of its own — a scene composes that on."
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "LunCoCatalogAPI", "LunCoProgramAPI", "LunCoUiSchemaAPI", "MaterialBindingAPI"]
    prepend references = @lunco://components/avionics/obc_lander.usda@</LanderOBC>
)
{
    bool lunco:ui:controlHud = true
    int lunco:ui:controlHudColumn = 0
    rel material:binding:physics = </Griffin1/PhysicsMaterials/LandingPadSlide>
    bool lunco:ui:schemaNode = false
    string lunco:ui:schemaRole = "Tracks attitude · applies commands"
    custom float lunco:payload_class_kg = 625.0
    custom string lunco:payload_class_status = "not a public flight ICD; Griffin study envelope"
    custom string lunco:parameter_status = "public configuration plus explicit simulator study values; flight ICD TBD"
    custom string lunco:provenance:source = "https://www.astrobotic.com/griffin"
    custom string lunco:collision:contract = "named proxy colliders own contact; render-only geometry is non-colliding"
    custom string lunco:egress = "FLIP payload adapter with port and starboard hinged ramps"
    uniform bool lunco:spawnable = true
    bool physics:rigidBodyEnabled = true
    float physics:mass = 4000.0
    float3 physics:diagonalInertia = (5905.0, 6250.0, 5905.0)
    float3 physics:centerOfMass = (0.0, 0.0, 0.0)
    float physxRigidBody:linearDamping = 0.0
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:sourceAsset = @lunco://models/Lander.mo@
    uniform bool lunco:program:realtimeSafe = true
    float inputs:spool_tau = 0.3499999940395355
    float inputs:authority_filter_tau_s = 0.019999999552965164
    float inputs:minimum_time_constant_s = 0.0000009999999974752427
    float inputs:authority_initial = 0.6000000238418579
    float inputs:command_lower_bound = 0.0
    float inputs:command_upper_bound = 1.0
    float inputs:landing_engine_cutoff = 0.0
    float inputs:ang_authority = 0.6000000238418579
    float inputs:command_tilt_limit_rad = 0.3499999940395355
    float inputs:attitude_hold = 1.0
    float inputs:hold_kp = 4.0 (
        customData = {
    double max = 12.0
    double min = 0.0
    string unit = "rad/s2"
}
    )
    float inputs:hold_kd = 6.0 (
        customData = {
    double max = 12.0
    double min = 0.0
    string unit = "rad/s"
}
    )
    float inputs:hold_torque_limit_nm = 6000.0
    float inputs:mass
    float inputs:mass.connect = </Griffin1/MainPropulsion.outputs:vehicle_mass_kg>
    float inputs:com_x
    float inputs:com_x.connect = </Griffin1/MainPropulsion.outputs:vehicle_com_x_m>
    float inputs:com_y
    float inputs:com_y.connect = </Griffin1/MainPropulsion.outputs:vehicle_com_y_m>
    float inputs:com_z
    float inputs:com_z.connect = </Griffin1/MainPropulsion.outputs:vehicle_com_z_m>
    float inputs:controller_inertia_xx
    float inputs:controller_inertia_xx.connect = </Griffin1/MainPropulsion.outputs:vehicle_inertia_xx_kg_m2>
    float inputs:controller_inertia_yy
    float inputs:controller_inertia_yy.connect = </Griffin1/MainPropulsion.outputs:vehicle_inertia_yy_kg_m2>
    float inputs:controller_inertia_zz
    float inputs:controller_inertia_zz.connect = </Griffin1/MainPropulsion.outputs:vehicle_inertia_zz_kg_m2>
    float inputs:piloted
    float inputs:piloted.connect = </Griffin1.outputs:piloted>
    float inputs:gyro_x
    float inputs:gyro_x.connect = </Griffin1/IMU.outputs:gyro_x>
    float inputs:gyro_y
    float inputs:gyro_y.connect = </Griffin1/IMU.outputs:gyro_y>
    float inputs:gyro_z
    float inputs:gyro_z.connect = </Griffin1/IMU.outputs:gyro_z>
    float inputs:attitude_error_x
    float inputs:attitude_error_x.connect = </Griffin1/AttitudeReference.outputs:error_x>
    float inputs:attitude_error_y
    float inputs:attitude_error_y.connect = </Griffin1/AttitudeReference.outputs:error_y>
    float inputs:attitude_error_z
    float inputs:attitude_error_z.connect = </Griffin1/AttitudeReference.outputs:error_z>
    float inputs:upright_axis_y
    float inputs:upright_axis_y.connect = </Griffin1/AttitudeReference.outputs:estimated_up_y>
    float inputs:leg_force_px
    float inputs:leg_force_px.connect = </Griffin1/LegPX.outputs:contact_force>
    float inputs:leg_force_nx
    float inputs:leg_force_nx.connect = </Griffin1/LegNX.outputs:contact_force>
    float inputs:leg_force_pz
    float inputs:leg_force_pz.connect = </Griffin1/LegPZ.outputs:contact_force>
    float inputs:leg_force_nz
    float inputs:leg_force_nz.connect = </Griffin1/LegNZ.outputs:contact_force>
    float inputs:leg_contact_px
    float inputs:leg_contact_px.connect = </Griffin1/LegPX.outputs:contact>
    float inputs:leg_contact_nx
    float inputs:leg_contact_nx.connect = </Griffin1/LegNX.outputs:contact>
    float inputs:leg_contact_pz
    float inputs:leg_contact_pz.connect = </Griffin1/LegPZ.outputs:contact>
    float inputs:leg_contact_nz
    float inputs:leg_contact_nz.connect = </Griffin1/LegNZ.outputs:contact>
    float inputs:leg_displacement_px
    float inputs:leg_displacement_px.connect = </Griffin1/LegPX_Spring.outputs:displacement>
    float inputs:leg_displacement_nx
    float inputs:leg_displacement_nx.connect = </Griffin1/LegNX_Spring.outputs:displacement>
    float inputs:leg_displacement_pz
    float inputs:leg_displacement_pz.connect = </Griffin1/LegPZ_Spring.outputs:displacement>
    float inputs:leg_displacement_nz
    float inputs:leg_displacement_nz.connect = </Griffin1/LegNZ_Spring.outputs:displacement>
    float inputs:leg_velocity_px
    float inputs:leg_velocity_px.connect = </Griffin1/LegPX_Spring.outputs:velocity>
    float inputs:leg_velocity_nx
    float inputs:leg_velocity_nx.connect = </Griffin1/LegNX_Spring.outputs:velocity>
    float inputs:leg_velocity_pz
    float inputs:leg_velocity_pz.connect = </Griffin1/LegPZ_Spring.outputs:velocity>
    float inputs:leg_velocity_nz
    float inputs:leg_velocity_nz.connect = </Griffin1/LegNZ_Spring.outputs:velocity>
    float inputs:navigation_velocity_x
    float inputs:navigation_velocity_x.connect = </Griffin1.outputs:velocity_x>
    float inputs:navigation_velocity_y
    float inputs:navigation_velocity_y.connect = </Griffin1.outputs:velocity_y>
    float inputs:navigation_velocity_z
    float inputs:navigation_velocity_z.connect = </Griffin1.outputs:velocity_z>
    def Scope "PhysicsMaterials"
    {
        def Material "LandingPadSlide" (
            prepend apiSchemas = "PhysicsMaterialAPI"
        )
        {
            float physics:dynamicFriction = 0.4000000059604645
            float physics:staticFriction = 0.5
            float physics:restitution = 0.0
            token physxMaterial:frictionCombineMode = "min"
        }
    }
    def Scope "MainPropulsion" (
        prepend apiSchemas = ["CollectionAPI:components", "LunCoUiSchemaAPI"]
    )
    {
        bool lunco:ui:schemaNode = true
        string ui:displayName = "Main engine"
        int lunco:ui:schemaColumn = 2
        int lunco:ui:schemaRow = 1
        string lunco:ui:schemaRole = "Throttle in · downward braking"
        uniform token collection:components:expansionRule = "explicitOnly"
        rel collection:components:includes
        prepend rel collection:components:includes = [</Griffin1/MainPropulsion/FuelTank>, </Griffin1/MainPropulsion/OxidizerTank>, </Griffin1/MainPropulsion/FuelPump>, </Griffin1/MainPropulsion/OxidizerPump>, </Griffin1/MainPropulsion/MainChamber>, </Griffin1/MainPropulsion/NozzleDesign>, </Griffin1/MainPropulsion/PlumePhotometry>, </Griffin1/MainPropulsion/PropellantStatus>]
        float inputs:valve_opening
        float inputs:valve_opening.connect = </Griffin1.outputs:throttle>
        float inputs:rcs_fuel_mass_flow_kgs
        float inputs:rcs_fuel_mass_flow_kgs.connect = </Griffin1/AttitudePropulsion.outputs:fuel_mass_flow_kgs>
        float inputs:rcs_oxidizer_mass_flow_kgs
        float inputs:rcs_oxidizer_mass_flow_kgs.connect = </Griffin1/AttitudePropulsion.outputs:oxidizer_mass_flow_kgs>
        float outputs:thrust_n
        float outputs:thrust_n.connect = </Griffin1/MainPropulsion/MainChamber.outputs:thrust_n>
        float outputs:exhaust_velocity_mps
        float outputs:exhaust_velocity_mps.connect = </Griffin1/MainPropulsion/MainChamber.outputs:exhaust_velocity_mps>
        float outputs:design_exhaust_velocity_mps
        float outputs:design_exhaust_velocity_mps.connect = </Griffin1/MainPropulsion/MainChamber.outputs:design_exhaust_velocity_mps>
        float outputs:maximum_thrust_n
        float outputs:maximum_thrust_n.connect = </Griffin1/MainPropulsion/MainChamber.outputs:maximum_thrust_n>
        float outputs:engine_activity
        float outputs:engine_activity.connect = </Griffin1/MainPropulsion/MainChamber.outputs:activity>
        float outputs:propellant_flow
        float outputs:propellant_flow.connect = </Griffin1/MainPropulsion/MainChamber.outputs:propellant_flow>
        float outputs:chamber_pressure_pa
        float outputs:chamber_pressure_pa.connect = </Griffin1/MainPropulsion/MainChamber.outputs:chamber_pressure_pa>
        float outputs:propellant_mass
        float outputs:propellant_mass.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:propellant_mass_kg>
        float outputs:propellant_fraction
        float outputs:propellant_fraction.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:propellant_fraction>
        float outputs:propellant_used
        float outputs:propellant_used.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:propellant_used_kg>
        float outputs:low_fuel
        float outputs:low_fuel.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:low_fuel>
        float outputs:depleted
        float outputs:depleted.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:depleted>
        float outputs:vehicle_mass_kg
        float outputs:vehicle_mass_kg.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_mass_kg>
        float outputs:vehicle_inertia_xx_kg_m2
        float outputs:vehicle_inertia_xx_kg_m2.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_xx_kg_m2>
        float outputs:vehicle_inertia_yy_kg_m2
        float outputs:vehicle_inertia_yy_kg_m2.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_yy_kg_m2>
        float outputs:vehicle_inertia_zz_kg_m2
        float outputs:vehicle_inertia_zz_kg_m2.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_zz_kg_m2>
        float outputs:vehicle_com_x_m
        float outputs:vehicle_com_x_m.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_com_x_m>
        float outputs:vehicle_com_y_m
        float outputs:vehicle_com_y_m.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_com_y_m>
        float outputs:vehicle_com_z_m
        float outputs:vehicle_com_z_m.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_com_z_m>
        def Scope "FuelRemainingTelemetry" (
            prepend apiSchemas = "LunCoTelemetryAPI"
        )
        {
            bool lunco:telemetry = true
            string ui:displayName = "FUEL LEFT"
            token lunco:telemetry:port = "propellant_mass"
            token lunco:telemetry:name = "lander.fuel_remaining"
            token lunco:telemetry:unit = "kg"
            string lunco:telemetry:description = "Remaining fuel and oxidizer mass from the lander's PropellantStatus model."
            rel lunco:telemetry:target = </Griffin1/MainPropulsion>
        }
        def Scope "MainThrustTelemetry" (
            prepend apiSchemas = "LunCoTelemetryAPI"
        )
        {
            bool lunco:telemetry = true
            string ui:displayName = "THRUST"
            token lunco:telemetry:port = "thrust_n"
            token lunco:telemetry:name = "lander.main_thrust"
            token lunco:telemetry:unit = "N"
            string lunco:telemetry:description = "Delivered main-engine thrust from the lander's Modelica propulsion model."
            rel lunco:telemetry:target = </Griffin1/MainPropulsion>
        }
        def Scope "FuelTank" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantTank.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:initial_mass_kg = 1000.0
            float inputs:nominal_pressure_pa = 2500000.0
            float inputs:pressure_headroom_pa = 500000.0
            float inputs:low_fuel_mass_kg = 100.0
            float inputs:depleted_mass_kg = 0.5
            float inputs:minimum_mass_kg = 0.0000009999999974752427
            float inputs:event_transition_width_kg = 0.009999999776482582
            float outputs:mass_kg
            float outputs:pressure_pa
            float outputs:mass_out_flow_kgs
            float outputs:low_fuel
            float outputs:depleted
            float inputs:auxiliary_mass_flow_kgs
            float inputs:auxiliary_mass_flow_kgs.connect = </Griffin1/MainPropulsion.inputs:rcs_fuel_mass_flow_kgs>
            custom token connectors:outlet
            token connectors:outlet.connect = </Griffin1/MainPropulsion/FuelPump.connectors:inlet>
        }
        def Scope "OxidizerTank" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantTank.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:initial_mass_kg = 1000.0
            float inputs:nominal_pressure_pa = 2500000.0
            float inputs:pressure_headroom_pa = 500000.0
            float inputs:low_fuel_mass_kg = 100.0
            float inputs:depleted_mass_kg = 0.5
            float inputs:minimum_mass_kg = 0.0000009999999974752427
            float inputs:event_transition_width_kg = 0.009999999776482582
            float outputs:mass_kg
            float outputs:pressure_pa
            float outputs:mass_out_flow_kgs
            float outputs:low_fuel
            float outputs:depleted
            float inputs:auxiliary_mass_flow_kgs
            float inputs:auxiliary_mass_flow_kgs.connect = </Griffin1/MainPropulsion.inputs:rcs_oxidizer_mass_flow_kgs>
            custom token connectors:outlet
            token connectors:outlet.connect = </Griffin1/MainPropulsion/OxidizerPump.connectors:inlet>
        }
        def Scope "FuelPump" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/Turbopump.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:maximum_flow_kgs = 8.0
            float inputs:nominal_tank_pressure_pa = 2500000.0
            float inputs:discharge_pressure_pa = 8000000.0
            float inputs:spool_tau = 0.07999999821186066
            float inputs:pump_efficiency = 0.7200000286102295
            float inputs:speed_rpm_max = 30000.0
            float inputs:propellant_density_kg_m3 = 810.0
            float inputs:minimum_pressure_pa = 1.0
            float inputs:minimum_efficiency = 0.0000009999999974752427
            float inputs:minimum_time_constant_s = 0.0000009999999974752427
            float inputs:minimum_available_mass_kg = 0.0000009999999974752427
            float inputs:availability_transition_mass_kg = 0.009999999776482582
            float outputs:mass_flow_kgs
            float outputs:outlet_pressure_pa
            float outputs:speed_fraction
            float outputs:speed_rpm
            float outputs:activity
            float outputs:shaft_power_w
            float inputs:available_mass_kg
            float inputs:available_mass_kg.connect = </Griffin1/MainPropulsion/FuelTank.outputs:mass_kg>
            float inputs:valve_opening
            float inputs:valve_opening.connect = </Griffin1/MainPropulsion.inputs:valve_opening>
            custom token connectors:inlet
            token connectors:inlet.connect = </Griffin1/MainPropulsion/FuelTank.connectors:outlet>
            custom token connectors:outlet
            token connectors:outlet.connect = </Griffin1/MainPropulsion/MainChamber.connectors:fuel_in>
        }
        def Scope "OxidizerPump" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/Turbopump.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:maximum_flow_kgs = 21.0
            float inputs:nominal_tank_pressure_pa = 2500000.0
            float inputs:discharge_pressure_pa = 8000000.0
            float inputs:spool_tau = 0.07999999821186066
            float inputs:pump_efficiency = 0.7200000286102295
            float inputs:speed_rpm_max = 30000.0
            float inputs:propellant_density_kg_m3 = 1140.0
            float inputs:minimum_pressure_pa = 1.0
            float inputs:minimum_efficiency = 0.0000009999999974752427
            float inputs:minimum_time_constant_s = 0.0000009999999974752427
            float inputs:minimum_available_mass_kg = 0.0000009999999974752427
            float inputs:availability_transition_mass_kg = 0.009999999776482582
            float outputs:mass_flow_kgs
            float outputs:outlet_pressure_pa
            float outputs:speed_fraction
            float outputs:speed_rpm
            float outputs:activity
            float outputs:shaft_power_w
            float inputs:available_mass_kg
            float inputs:available_mass_kg.connect = </Griffin1/MainPropulsion/OxidizerTank.outputs:mass_kg>
            float inputs:valve_opening
            float inputs:valve_opening.connect = </Griffin1/MainPropulsion.inputs:valve_opening>
            custom token connectors:inlet
            token connectors:inlet.connect = </Griffin1/MainPropulsion/OxidizerTank.connectors:outlet>
            custom token connectors:outlet
            token connectors:outlet.connect = </Griffin1/MainPropulsion/MainChamber.connectors:oxidizer_in>
        }
        def Scope "MainChamber" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/CombustionChamber.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:oxidizer_to_fuel_ratio = 2.5999999046325684
            float inputs:characteristic_velocity_mps = 1550.0
            float inputs:throat_area_m2 = 0.0044999998062849045
            float inputs:effective_exhaust_velocity_mps = 2940.0
            float inputs:combustion_efficiency = 0.9599999785423279
            float inputs:nominal_flow_kgs = 31.75
            float inputs:chamber_temperature_full_k = 3300.0
            float inputs:minimum_flow_kgs = 0.0000009999999974752427
            float inputs:minimum_throat_area_m2 = 0.0000000009999999717180685
            float inputs:minimum_mixture_ratio = 0.0000009999999974752427
            float inputs:fuel_energy_j_kg = 40000000.0
            custom token connectors:fuel_in
            custom token connectors:oxidizer_in
            float outputs:fuel_flow_kgs
            float outputs:oxidizer_flow_kgs
            float outputs:propellant_flow
            float outputs:mixture_ratio
            float outputs:mixture_ratio_error
            float outputs:mixture_efficiency
            float outputs:chamber_pressure_pa
            float outputs:ideal_chamber_pressure_pa
            float outputs:chamber_temperature_k
            float outputs:thrust_n
            float outputs:exhaust_velocity_mps
            float outputs:design_exhaust_velocity_mps
            float outputs:maximum_thrust_n
            float outputs:activity
            float outputs:heat_release_w
        }
        def Scope "NozzleDesign" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/BellNozzle.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:throat_radius = 0.11999999731779099
            float inputs:exit_radius = 0.3400000035762787
            float inputs:length = 0.5199999809265137
            float inputs:contour = 1.0
            float outputs:exit_area
            float outputs:exit_radius_m
            float inputs:gamma = 1.2000000476837158
            float inputs:p_chamber = 5500000.0
            float inputs:p_exit = 8000.0
            float inputs:p_ambient = 0.0
            float inputs:g0 = 9.806650161743164
        }
        def Scope "PlumePhotometry" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PlumePhotometry.mo@
            uniform bool lunco:program:realtimeSafe = true
            float outputs:render_throttle
            float outputs:visual_length_fraction
            float outputs:intensity
            float outputs:radius
            float inputs:nozzle_exit_pressure_pa = 0.0
            float inputs:design_chamber_pressure_pa = 0.0
            float inputs:ambient_pressure_pa = 0.0
            float inputs:pressure_threshold_pa = 1000.0
            float inputs:geometry_capacity_m = 4.0
            float inputs:w_max = 0.27000001072883606
            float inputs:luminance = 15.04699993133545
            float inputs:throttle
            float inputs:throttle.connect = </Griffin1/MainPropulsion.outputs:engine_activity>
            float inputs:thrust_n
            float inputs:thrust_n.connect = </Griffin1/MainPropulsion.outputs:thrust_n>
            float inputs:maximum_thrust_n
            float inputs:maximum_thrust_n.connect = </Griffin1/MainPropulsion.outputs:maximum_thrust_n>
            float inputs:propellant_flow_kgs
            float inputs:propellant_flow_kgs.connect = </Griffin1/MainPropulsion.outputs:propellant_flow>
            float inputs:exhaust_velocity_mps
            float inputs:exhaust_velocity_mps.connect = </Griffin1/MainPropulsion.outputs:exhaust_velocity_mps>
            float inputs:design_exhaust_velocity_mps
            float inputs:design_exhaust_velocity_mps.connect = </Griffin1/MainPropulsion.outputs:design_exhaust_velocity_mps>
            float inputs:nozzle_exit_radius_m
            float inputs:nozzle_exit_radius_m.connect = </Griffin1/MainPropulsion/NozzleDesign.outputs:exit_radius_m>
            float inputs:nozzle_exit_area_m2
            float inputs:nozzle_exit_area_m2.connect = </Griffin1/MainPropulsion/NozzleDesign.outputs:exit_area>
            float inputs:chamber_pressure_pa
            float inputs:chamber_pressure_pa.connect = </Griffin1/MainPropulsion.outputs:chamber_pressure_pa>
        }
        def Scope "PropellantStatus" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantStatus.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:low_fuel_mass_kg = 200.0
            float inputs:depleted_mass_kg = 1.0
            float inputs:initial_propellant_mass_kg = 2000.0
            float inputs:minimum_mass_kg = 0.0000009999999974752427
            float inputs:event_transition_width_kg = 0.009999999776482582
            float inputs:dry_mass_kg = 2000.0
            float inputs:dry_inertia_xx_kg_m2 = 4625.0
            float inputs:dry_inertia_yy_kg_m2 = 6250.0
            float inputs:dry_inertia_zz_kg_m2 = 4625.0
            float inputs:fuel_position_y_m = 0.800000011920929
            float inputs:oxidizer_position_y_m = -0.800000011920929
            float outputs:propellant_mass_kg
            float outputs:propellant_used_kg
            float outputs:propellant_fraction
            float outputs:low_fuel
            float outputs:depleted
            float outputs:vehicle_mass_kg
            float outputs:vehicle_inertia_xx_kg_m2
            float outputs:vehicle_inertia_yy_kg_m2
            float outputs:vehicle_inertia_zz_kg_m2
            float outputs:vehicle_com_x_m
            float outputs:vehicle_com_y_m
            float outputs:vehicle_com_z_m
            float inputs:fuel_mass_kg
            float inputs:fuel_mass_kg.connect = </Griffin1/MainPropulsion/FuelTank.outputs:mass_kg>
            float inputs:oxidizer_mass_kg
            float inputs:oxidizer_mass_kg.connect = </Griffin1/MainPropulsion/OxidizerTank.outputs:mass_kg>
        }
    }
    def Scope "AttitudeActuation" (
        prepend apiSchemas = ["CollectionAPI:components", "LunCoUiSchemaAPI"]
