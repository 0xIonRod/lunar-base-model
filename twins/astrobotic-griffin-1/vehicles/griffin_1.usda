    # The current OBC reference does not expose a standalone GNC prim. Keep
    # the event interface typed and inspectable until a guidance implementation
    # is composed here; Rhai tests treat these as inert request channels.
    def Scope "GNC"
    {
        float outputs:landing_engine_cutoff_request = 0.0
        float outputs:landing_handoff_request = 0.0
    }
