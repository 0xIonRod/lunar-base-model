    def Xform "Nozzle"
    {
        def Xform "MainEngineCluster"
        {
            def Xform "Engine01" (
                prepend references = @twin://astrobotic-griffin-1/components/lander/griffin_engine_bell_visual.usda@</EngineBell>
            )
            {
                custom double3 xformOp:translate = (0.0, 0.34, 0.0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                def "Exhaust"
                {
                    def "Flame"
                    {
                        custom float inputs:throttle
                        float inputs:throttle.connect = </Griffin1/MainPropulsion/PlumePhotometry.outputs:render_throttle>
                        custom float inputs:plume_length_fraction
                        float inputs:plume_length_fraction.connect = </Griffin1/MainPropulsion/PlumePhotometry.outputs:visual_length_fraction>
                        custom float inputs:fuel_color_r
