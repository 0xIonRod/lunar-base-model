    }
    def "Altimeter" (
        prepend references = @lunco://vessels/sensors/altimeter.usda@</Altimeter>
    )
    {
        # Nadir range sensor mounted at the underside of the bus. The sensor
        # is a real component reference; its Modelica outputs are the altitude
        # source consumed by the scene guidance computer.
        double3 xformOp:translate = (0.0, -3.3, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Model"
        {
            float inputs:attitude_quat_w.connect = </Griffin1/IMU.outputs:attitude_quat_w>
            float inputs:attitude_quat_x.connect = </Griffin1/IMU.outputs:attitude_quat_x>
            float inputs:attitude_quat_y.connect = </Griffin1/IMU.outputs:attitude_quat_y>
            float inputs:attitude_quat_z.connect = </Griffin1/IMU.outputs:attitude_quat_z>
            float inputs:angular_velocity_local_x.connect = </Griffin1/IMU.outputs:gyro_x>
            float inputs:angular_velocity_local_y.connect = </Griffin1/IMU.outputs:gyro_y>
            float inputs:angular_velocity_local_z.connect = </Griffin1/IMU.outputs:gyro_z>
        }
        over "Beam"
        {
            token visibility = "invisible"
        }
        over "Hit"
        {
            token visibility = "invisible"
        }
    }
    def "IMU" (
        prepend references = @lunco://vessels/sensors/imu.usda@</Imu>
    )
    {
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:raw_acceleration_x
        float inputs:raw_acceleration_x.connect = </Griffin1.outputs:acceleration_x>
        float inputs:raw_acceleration_y
        float inputs:raw_acceleration_y.connect = </Griffin1.outputs:acceleration_y>
        float inputs:raw_acceleration_z
        float inputs:raw_acceleration_z.connect = </Griffin1.outputs:acceleration_z>
        float inputs:raw_sample_valid
        float inputs:raw_sample_valid.connect = </Griffin1.outputs:acceleration_valid>
        float inputs:raw_angvel_x
        float inputs:raw_angvel_x.connect = </Griffin1.outputs:angvel_x>
        float inputs:raw_angvel_y
        float inputs:raw_angvel_y.connect = </Griffin1.outputs:angvel_y>
        float inputs:raw_angvel_z
        float inputs:raw_angvel_z.connect = </Griffin1.outputs:angvel_z>
        float inputs:raw_quat_w
        float inputs:raw_quat_w.connect = </Griffin1.outputs:quat_w>
        float inputs:raw_quat_x
        float inputs:raw_quat_x.connect = </Griffin1.outputs:quat_x>
        float inputs:raw_quat_y
        float inputs:raw_quat_y.connect = </Griffin1.outputs:quat_y>
        float inputs:raw_quat_z
        float inputs:raw_quat_z.connect = </Griffin1.outputs:quat_z>
        float inputs:gravity_world_x
        float inputs:gravity_world_x.connect = </Griffin1/Environment.outputs:gravity_x>
        float inputs:gravity_world_y
        float inputs:gravity_world_y.connect = </Griffin1/Environment.outputs:gravity_y>
        float inputs:gravity_world_z
        float inputs:gravity_world_z.connect = </Griffin1/Environment.outputs:gravity_z>
    }
