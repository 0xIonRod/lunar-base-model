        double outputs:vehicle_inertia_xx_kg_m2.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_xx_kg_m2>
        custom double outputs:vehicle_inertia_yy_kg_m2
        double outputs:vehicle_inertia_yy_kg_m2.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_yy_kg_m2>
        custom double outputs:vehicle_inertia_zz_kg_m2
        double outputs:vehicle_inertia_zz_kg_m2.connect = </Griffin1/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_zz_kg_m2>
        def Scope "FuelRemainingTelemetry" (
            prepend apiSchemas = ["LunCoTelemetryAPI"]
        )
        {
            bool lunco:telemetry = true
            string ui:displayName = "FUEL LEFT"
            token lunco:telemetry:port = "propellant_mass"
            token lunco:telemetry:name = "lander.fuel_remaining"
            token lunco:telemetry:unit = "kg"
            string lunco:telemetry:description = "Remaining fuel and oxidizer mass from the lander's PropellantStatus model."
            rel lunco:telemetry:target = </Griffin1/MainPropulsion>
        }
        def Scope "FuelTank" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantTank.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:low_fuel_mass_kg = 100.0
            float inputs:depleted_mass_kg = 0.5
            float inputs:minimum_mass_kg = 0.0000009999999974752427
            float inputs:event_transition_width_kg = 0.009999999776482582
            float outputs:mass_kg
            float outputs:pressure_pa
            float outputs:mass_out_flow_kgs
            float outputs:low_fuel
            float outputs:depleted
            float inputs:auxiliary_mass_flow_kgs
            float inputs:auxiliary_mass_flow_kgs.connect = </Griffin1/MainPropulsion.inputs:rcs_fuel_mass_flow_kgs>
            custom token connectors:outlet
            token connectors:outlet.connect = [</Griffin1/MainPropulsion/Engine01.connectors:fuel_in>, </Griffin1/MainPropulsion/Engine02.connectors:fuel_in>, </Griffin1/MainPropulsion/Engine03.connectors:fuel_in>, </Griffin1/MainPropulsion/Engine04.connectors:fuel_in>, </Griffin1/MainPropulsion/Engine05.connectors:fuel_in>, </Griffin1/MainPropulsion/Engine06.connectors:fuel_in>, </Griffin1/MainPropulsion/Engine07.connectors:fuel_in>]
            custom double inputs:initial_mass_kg = 1000.0
            custom double inputs:nominal_pressure_pa = 2500000.0
            custom double inputs:pressure_headroom_pa = 500000.0
        }
        def Scope "OxidizerTank" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantTank.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:low_fuel_mass_kg = 100.0
            float inputs:depleted_mass_kg = 0.5
            float inputs:minimum_mass_kg = 0.0000009999999974752427
            float inputs:event_transition_width_kg = 0.009999999776482582
            float outputs:mass_kg
            float outputs:pressure_pa
            float outputs:mass_out_flow_kgs
            float outputs:low_fuel
            float outputs:depleted
            float inputs:auxiliary_mass_flow_kgs
            float inputs:auxiliary_mass_flow_kgs.connect = </Griffin1/MainPropulsion.inputs:rcs_oxidizer_mass_flow_kgs>
            custom token connectors:outlet
            token connectors:outlet.connect = [</Griffin1/MainPropulsion/Engine01.connectors:oxidizer_in>, </Griffin1/MainPropulsion/Engine02.connectors:oxidizer_in>, </Griffin1/MainPropulsion/Engine03.connectors:oxidizer_in>, </Griffin1/MainPropulsion/Engine04.connectors:oxidizer_in>, </Griffin1/MainPropulsion/Engine05.connectors:oxidizer_in>, </Griffin1/MainPropulsion/Engine06.connectors:oxidizer_in>, </Griffin1/MainPropulsion/Engine07.connectors:oxidizer_in>]
