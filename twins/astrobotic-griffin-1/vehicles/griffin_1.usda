    def "Altimeter" (
        prepend references = @lunco://vessels/sensors/altimeter.usda@</Altimeter>
    )
    {
        double3 xformOp:translate = (0.0, -0.35, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Model"
        {
            float inputs:attitude_quat_w
            float inputs:attitude_quat_w.connect = </Griffin1/IMU.outputs:attitude_quat_w>
            float inputs:attitude_quat_x
