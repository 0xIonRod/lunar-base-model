    def "Altimeter" (
        prepend references = @lunco://vessels/sensors/altimeter.usda@</Altimeter>
    )
    {
        double3 xformOp:translate = (0.0, -0.35, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Model"
        {
            float inputs:attitude_quat_w
            float inputs:attitude_quat_w.connect = </Griffin1/IMU.outputs:attitude_quat_w>
            float inputs:attitude_quat_x
            float inputs:attitude_quat_x.connect = </Griffin1/IMU.outputs:attitude_quat_x>
            float inputs:attitude_quat_y
            float inputs:attitude_quat_y.connect = </Griffin1/IMU.outputs:attitude_quat_y>
            float inputs:attitude_quat_z
            float inputs:attitude_quat_z.connect = </Griffin1/IMU.outputs:attitude_quat_z>
            float inputs:angular_velocity_local_x
            float inputs:angular_velocity_local_x.connect = </Griffin1/IMU.outputs:gyro_x>
            float inputs:angular_velocity_local_y
            float inputs:angular_velocity_local_y.connect = </Griffin1/IMU.outputs:gyro_y>
            float inputs:angular_velocity_local_z
            float inputs:angular_velocity_local_z.connect = </Griffin1/IMU.outputs:gyro_z>
        }
        over "Beam"
        {
            token visibility = "invisible"
        }
        over "Hit"
        {
            token visibility = "invisible"
        }
    }
