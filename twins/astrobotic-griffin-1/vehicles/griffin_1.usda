    def Scope "Looks"
    {
        def Material "Nozzle_Mat"
        {
            token outputs:surface
            token outputs:surface.connect = </Griffin1/Looks/Nozzle_Mat/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.20000000298023224, 0.17000000178813934, 0.15000000596046448)
                float inputs:metallic = 0.8500000238418579
                float inputs:roughness = 0.3799999952316284
                color3f inputs:emissiveColor = (0.05999999865889549, 0.02500000037252903, 0.00800000037997961)
                token outputs:surface
            }
        }
        def Material "StrutGlow_Mat"
        {
            token outputs:surface
            token outputs:surface.connect = </Griffin1/Looks/StrutGlow_Mat/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/strut_glow.wgsl@
                color3f inputs:base_color = (0.550000011920929, 0.550000011920929, 0.5699999928474426)
                color3f inputs:hot_color = (0.949999988079071, 0.1599999964237213, 0.05000000074505806)
                float inputs:load_frac = 0.0
                float inputs:glow = 3.0
                float inputs:roughness = 0.44999998807907104
                float inputs:metallic = 0.699999988079071
                token outputs:surface
            }
        }
        def Material "MliFoil_Mat"
        {
            token outputs:surface
            token outputs:surface.connect = </Griffin1/Looks/MliFoil_Mat/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/mli_foil.wgsl@
                color3f inputs:foil_color = (0.8299999833106995, 0.6200000047683716, 0.18000000715255737)
                color3f inputs:shade_color = (0.18000000715255737, 0.12999999523162842, 0.03999999910593033)
                float inputs:crinkle = 32.0
                float inputs:facet_depth = 1.0
                float inputs:sheen = 0.8500000238418579
                float inputs:v_scale = 1.0
                token outputs:surface
            }
        }
        def Material "SolarWing_Mat"
        {
            token outputs:surface
            token outputs:surface.connect = </Griffin1/Looks/SolarWing_Mat/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/solar_panel.wgsl@
                float inputs:v_scale = 1.7000000476837158
                float inputs:cell_rows = 8.0
                float inputs:cell_cols = 14.0
                float inputs:cell_gap = 0.009999999776482582
                float inputs:bus_width = 0.004000000189989805
                float inputs:border = 0.05000000074505806
                color3f inputs:cell_color = (0.03999999910593033, 0.05000000074505806, 0.2800000011920929)
                color3f inputs:bus_color = (0.8999999761581421, 0.8999999761581421, 0.949999988079071)
                color3f inputs:frame_color = (0.15000000596046448, 0.15000000596046448, 0.18000000715255737)
                token outputs:surface
            }
        }
    }
    def LunCoEvent "LowFuel"
    {
        uniform token lunco:event:name = "lander_low_fuel"
        uniform token lunco:event:severity = "warning"
        uniform double lunco:event:qualificationTime = 0.0
        float inputs:trigger
        float inputs:trigger.connect = </Griffin1/MainPropulsion.outputs:low_fuel>
    }
    def LunCoEvent "Depleted"
    {
        uniform token lunco:event:name = "lander_depleted"
        uniform token lunco:event:severity = "warning"
        uniform double lunco:event:qualificationTime = 0.0
        float inputs:trigger
        float inputs:trigger.connect = </Griffin1/MainPropulsion.outputs:depleted>
    }
    def LunCoEvent "EngineCutoff"
    {
        uniform token lunco:event:name = "lander_engine_cutoff"
        uniform token lunco:event:severity = "info"
        uniform bool lunco:event:latched = true
        uniform double lunco:event:qualificationTime = 0.0
        float inputs:trigger
        float inputs:trigger.connect = </Griffin1/GNC.outputs:landing_engine_cutoff_request>
    }
    def LunCoEvent "FlightHandoff"
    {
        uniform token lunco:event:name = "lander_flight_handoff"
        uniform token lunco:event:severity = "info"
        uniform bool lunco:event:latched = true
        uniform double lunco:event:qualificationTime = 0.0
        float inputs:trigger
        float inputs:trigger.connect = </Griffin1/GNC.outputs:landing_handoff_request>
    }
    def Scope "GNC"
    {
        float outputs:landing_engine_cutoff_request = 0.0
        float outputs:landing_handoff_request = 0.0
    }
    def LunCoEvent "Touchdown"
    {
        uniform token lunco:event:name = "lander_touchdown"
        uniform token lunco:event:severity = "info"
        uniform bool lunco:event:latched = true
        uniform double lunco:event:qualificationTime = 0.0
        float inputs:trigger
        float inputs:trigger.connect = </Griffin1.outputs:touchdown>
    }
    def Scope "Subsystems" (
        prepend apiSchemas = "LunCoProgramAPI"
        documentation = "Reacts to touchdown and propellant events. Does not fly the vehicle."
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/lander_subsystems.rhai@
    }
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</LanderControls>
    )
    {
        custom double lunco:cameraFollowHeight = 2.08
    }
    def "Altimeter" (
        prepend references = @lunco://vessels/sensors/altimeter.usda@</Altimeter>
    )
    {
        double3 xformOp:translate = (0.0, -0.35, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Model"
        {
            float inputs:attitude_quat_w
            float inputs:attitude_quat_w.connect = </Griffin1/IMU.outputs:attitude_quat_w>
            float inputs:attitude_quat_x
            float inputs:attitude_quat_x.connect = </Griffin1/IMU.outputs:attitude_quat_x>
            float inputs:attitude_quat_y
            float inputs:attitude_quat_y.connect = </Griffin1/IMU.outputs:attitude_quat_y>
            float inputs:attitude_quat_z
            float inputs:attitude_quat_z.connect = </Griffin1/IMU.outputs:attitude_quat_z>
            float inputs:angular_velocity_local_x
            float inputs:angular_velocity_local_x.connect = </Griffin1/IMU.outputs:gyro_x>
            float inputs:angular_velocity_local_y
            float inputs:angular_velocity_local_y.connect = </Griffin1/IMU.outputs:gyro_y>
            float inputs:angular_velocity_local_z
            float inputs:angular_velocity_local_z.connect = </Griffin1/IMU.outputs:gyro_z>
        }
        over "Beam"
        {
            token visibility = "invisible"
        }
        over "Hit"
        {
            token visibility = "invisible"
        }
    }
    def "IMU" (
        prepend references = @lunco://vessels/sensors/imu.usda@</Imu>
