#usda 1.0
(
    defaultPrim = "FLIP"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "FLIP" (
    kind = "assembly"
)
{
    custom string lunco:visual:status = "componentized review proxy; no flight CAD"
