#usda 1.0
(
    defaultPrim = "FLIP"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "FLIP" (
    prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
    variants = { string "drivetrain" = "physical"; string "power" = "battery" }
)
{
    double3 xformOp:translate = (0.0, 0.0, 0.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    float physics:mass = 343.0
    float3 physics:diagonalInertia = (132.4629364013672, 190.2515869140625, 66.75328826904297)
    float3 physics:centerOfMass = (0.0, -0.13500000536441803, 0.0)
    custom string lunco:ui:surfaceId = "vessel-hud"
    custom string lunco:ui:visibilityMode = "possessed"
    custom float outputs:bus_voltage
    float outputs:bus_voltage.connect = </FLIP/Battery.outputs:terminal_voltage_v>
    custom float outputs:bus_current
    float outputs:bus_current.connect = </FLIP/Battery.outputs:terminal_current_a>
    custom float outputs:bus_power
    float outputs:bus_power.connect = </FLIP/Battery.outputs:net_power_w>
    custom float outputs:battery_soc
    float outputs:battery_soc.connect = </FLIP/Battery.outputs:soc_out>
    float outputs:battery_drained
    float outputs:battery_drained.connect = </FLIP/Battery.outputs:drained>
    rel collection:components:includes = [</FLIP/Drivetrain>, </FLIP/Battery>, </FLIP/SolarMechanism/Photovoltaics>, </FLIP/Motor_FL>, </FLIP/TorqueSource_FL>, </FLIP/Gearbox_FL>, </FLIP/Shaft_FL>, </FLIP/Motor_FR>, </FLIP/TorqueSource_FR>, </FLIP/Gearbox_FR>, </FLIP/Shaft_FR>, </FLIP/Motor_RL>, </FLIP/TorqueSource_RL>, </FLIP/Gearbox_RL>, </FLIP/Shaft_RL>, </FLIP/Motor_RR>, </FLIP/TorqueSource_RR>, </FLIP/Gearbox_RR>, </FLIP/Shaft_RR>]
    custom double outputs:solar_power
    double outputs:solar_power.connect = </FLIP/SolarMechanism/Photovoltaics.outputs:power_out>
    custom double outputs:solar_available_power
    double outputs:solar_available_power.connect = </FLIP/SolarMechanism/Photovoltaics.outputs:available_power_w>
    custom double outputs:solar_cos_incidence
    double outputs:solar_cos_incidence.connect = </FLIP/SolarMechanism/Photovoltaics.outputs:cos_incidence>
    custom double outputs:solar_temperature_k
    double outputs:solar_temperature_k.connect = </FLIP/SolarMechanism/Photovoltaics.outputs:temperature_k>
    custom double outputs:solar_heat_w
    double outputs:solar_heat_w.connect = </FLIP/SolarMechanism/Photovoltaics.outputs:heat_w>
    custom double inputs:irradiance
    double inputs:irradiance.connect = </FLIP/SolarMechanism/Photovoltaics/Environment.outputs:sun_irradiance_w_m2>
    custom double inputs:sun_visibility
    double inputs:sun_visibility.connect = </FLIP/SolarMechanism/Photovoltaics/Environment.outputs:sun_visibility>
    custom double inputs:target_mount_x
    double inputs:target_mount_x.connect = </FLIP/SolarMechanism/Photovoltaics/Environment.outputs:sun_mount_x>
    custom double inputs:target_mount_y
    double inputs:target_mount_y.connect = </FLIP/SolarMechanism/Photovoltaics/Environment.outputs:sun_mount_y>
    custom double inputs:target_mount_z
    double inputs:target_mount_z.connect = </FLIP/SolarMechanism/Photovoltaics/Environment.outputs:sun_mount_z>
    def "Chassis"
    {
        double3 xformOp:scale = (1.476, 0.396, 2.116)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        uniform token purpose = "proxy"
        token visibility = "invisible"
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.135, 0.0)
    }
    def "Headlight_L" (
        active = false
    )
    {
    }
    def "Headlight_R" (
        active = false
    )
    {
    }
    def "FrontCamera" (
        active = true
