    def Scope "Thermal" (
        prepend apiSchemas = "CollectionAPI:components"
        documentation = "FLIP motor thermal network: four motor losses into left/right masses and radiators."
        active = false
    )
    {
        uniform token collection:components:expansionRule = "explicitOnly"
        rel collection:components:includes
        prepend rel collection:components:includes = [</FLIP/Thermal/MotorHeat_FL>, </FLIP/Thermal/MotorHeat_RL>, </FLIP/Thermal/MotorHeat_FR>, </FLIP/Thermal/MotorHeat_RR>, </FLIP/Thermal/MotorThermalLeft>, </FLIP/Thermal/MotorThermalRight>, </FLIP/Thermal/MotorRadiatorLeft>, </FLIP/Thermal/MotorRadiatorRight>, </FLIP/Thermal/ThermalBridge>]
        float inputs:motor_heat_FL
        float inputs:motor_heat_FL.connect = </FLIP/Motor_FL.outputs:heat>
        float inputs:motor_heat_FR
        float inputs:motor_heat_FR.connect = </FLIP/Motor_FR.outputs:heat>
        float inputs:motor_heat_RL
        float inputs:motor_heat_RL.connect = </FLIP/Motor_RL.outputs:heat>
        float inputs:motor_heat_RR
        float inputs:motor_heat_RR.connect = </FLIP/Motor_RR.outputs:heat>
        float outputs:motor_temp_left
        float outputs:motor_temp_left.connect = </FLIP/Thermal/MotorThermalLeft.outputs:temp_k>
        float outputs:motor_temp_right
        float outputs:motor_temp_right.connect = </FLIP/Thermal/MotorThermalRight.outputs:temp_k>
        def Xform "ThermalBridge" (
            prepend references = @lunco://components/thermal/motor_thermal.usda@</ThermalConductor>
