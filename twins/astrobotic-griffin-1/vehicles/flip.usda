#usda 1.0
(
    defaultPrim = "FLIP"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "FLIP" (
    documentation = "Astrolab FLIP four-wheel lunar rover study proxy with finite EPS and Modelica drivetrain."
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "PhysxVehicleContextAPI", "PhysxVehicleAckermannSteeringAPI", "LunCoCatalogAPI", "CollectionAPI:components"]
    prepend references = [@lunco://components/avionics/obc.usda@</OBC>, @lunco://components/cameras/rover_front_camera.usda@</RoverFrontCamera>]
    prepend variantSets = "drivetrain"
    variants = { string "drivetrain" = "raycast" }
)
{
    uniform bool lunco:spawnable = true
    custom string lunco:mission:payload = "Astrolab FLIP"
    custom string lunco:mission:vehicle_family = "FLEX Lunar Innovation Platform"
    custom string lunco:configuration = "four-wheel all-wheel-steer study proxy"
    custom string lunco:parameter_status = "public envelope plus explicit simulator assumptions"
    custom string lunco:provenance:source = "https://www.astrolab.space/flip-rover/"
    custom string lunco:provenance:video = "https://www.youtube.com/watch?v=UFEMOrg27KE"
    custom string lunco:provenance:engineering_boundary = "replace proxy values with FLIP as-built CAD and test data"
    float physics:mass = 450.0
    float3 physics:centerOfMass = (0.0, -0.05000000074505806, 0.0)
    float3 physics:diagonalInertia = (240.0, 337.5, 145.5)
    float physxRigidBody:linearDamping = 0.5
    float physxRigidBody:angularDamping = 2.0
    float physxVehicleAckermannSteering:maxSteerAngle = 0.44999998807907104
    float physxVehicleAckermannSteering:strength = 0.0
    float outputs:drive_left = 0.0
    float outputs:drive_right = 0.0
    float outputs:steering = 0.0
    float outputs:brake = 0.0
    uniform token collection:components:expansionRule = "explicitOnly"
    rel collection:components:includes
    prepend rel collection:components:includes = [</FLIP/Battery>, </FLIP/SolarArray>, </FLIP/Motor_FL>, </FLIP/TorqueSource_FL>, </FLIP/Gearbox_FL>, </FLIP/Shaft_FL>, </FLIP/Motor_FR>, </FLIP/TorqueSource_FR>, </FLIP/Gearbox_FR>, </FLIP/Shaft_FR>, </FLIP/Motor_RL>, </FLIP/TorqueSource_RL>, </FLIP/Gearbox_RL>, </FLIP/Shaft_RL>, </FLIP/Motor_RR>, </FLIP/TorqueSource_RR>, </FLIP/Gearbox_RR>, </FLIP/Shaft_RR>]
    float inputs:drive_left
    float inputs:drive_left.connect = </FLIP.outputs:drive_left>
    float inputs:drive_right
    float inputs:drive_right.connect = </FLIP.outputs:drive_right>
    float inputs:shaft_speed_FL
    float inputs:shaft_speed_FL.connect = </FLIP/Suspension_FL/Wheel_FL.outputs:shaft_speed>
    float inputs:shaft_speed_FR
    float inputs:shaft_speed_FR.connect = </FLIP/Suspension_FR/Wheel_FR.outputs:shaft_speed>
    float inputs:shaft_speed_RL
    float inputs:shaft_speed_RL.connect = </FLIP/Suspension_RL/Wheel_RL.outputs:shaft_speed>
    float inputs:shaft_speed_RR
    float inputs:shaft_speed_RR.connect = </FLIP/Suspension_RR/Wheel_RR.outputs:shaft_speed>
    float outputs:bus_voltage
    float outputs:bus_voltage.connect = </FLIP/Battery.outputs:terminal_voltage_v>
    float outputs:bus_current
    float outputs:bus_current.connect = </FLIP/Battery.outputs:terminal_current_a>
    float outputs:bus_power
    float outputs:bus_power.connect = </FLIP/Battery.outputs:net_power_w>
    float outputs:battery_soc
    float outputs:battery_soc.connect = </FLIP/Battery.outputs:soc_out>
    float outputs:battery_drained
    float outputs:battery_drained.connect = </FLIP/Battery.outputs:drained>
    float outputs:solar_power
    float outputs:solar_power.connect = </FLIP/SolarArray.outputs:power_out>
    float outputs:solar_available_power
    float outputs:solar_available_power.connect = </FLIP/SolarArray.outputs:available_power_w>
    custom string lunco:steering:status = "full Ackermann correction enabled; four authored wheel steer ports use the shared steering actuator"
    custom string lunco:wheel:geometry = "four solid 0.45 m radius x 0.28 m width wheel assemblies; each composes regolith tire, collision, and 0.70 m suspension"
    variantSet "drivetrain" = {
        "raycast" {
        }
        "physical" (
            prepend references = @lunco://components/mobility/physical_drivetrain.usda@</Drivetrain>
        ) {
            over "Suspension_FL" (
                prepend apiSchemas = "PhysicsRigidBodyAPI"
            )
            {
            }
            over "Suspension_FR" (
                prepend apiSchemas = "PhysicsRigidBodyAPI"
            )
            {
            }
            over "Suspension_RL" (
                prepend apiSchemas = "PhysicsRigidBodyAPI"
            )
            {
            }
            over "Suspension_RR" (
                prepend apiSchemas = "PhysicsRigidBodyAPI"
            )
            {
            }
            over "Suspension_FL/Wheel_FL" (
                prepend apiSchemas = "PhysicsFilteredPairsAPI"
            )
            {
                rel physics:filteredPairs = </FLIP/Chassis>
            }
            over "Suspension_FR/Wheel_FR" (
                prepend apiSchemas = "PhysicsFilteredPairsAPI"
            )
            {
                rel physics:filteredPairs = </FLIP/Chassis>
            }
            over "Suspension_RL/Wheel_RL" (
                prepend apiSchemas = "PhysicsFilteredPairsAPI"
            )
            {
                rel physics:filteredPairs = </FLIP/Chassis>
            }
            over "Suspension_RR/Wheel_RR" (
                prepend apiSchemas = "PhysicsFilteredPairsAPI"
            )
            {
                rel physics:filteredPairs = </FLIP/Chassis>
            }
        }
    }
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</RoverControls>
    )
    {
    }
    def Cube "Chassis" (
        prepend references = @lunco://components/mobility/chassis/box_chassis.usda@</Chassis>
    )
    {
        double3 xformOp:scale = (2.4, 0.42, 3.15)
        color3f[] primvars:displayColor = [(0.20000000298023224, 0.23999999463558197, 0.2800000011920929)]
    }
    def Cube "PayloadDeck" (
        prepend apiSchemas = "PhysicsCollisionAPI"
    )
    {
        double3 xformOp:translate = (0.0, 0.38, 0.0)
        double3 xformOp:scale = (1.45, 0.08, 0.95)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.47999998927116394, 0.5, 0.5199999809265137)]
    }
    def Xform "SensorMast"
    {
        def Cylinder "Post"
        {
            double radius = 0.06
            double height = 0.55
            double3 xformOp:translate = (0.0, 0.78, -0.25)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.3499999940395355, 0.3700000047683716, 0.4000000059604645)]
        }
        def Cube "SensorBar"
        {
            double3 xformOp:translate = (0.0, 1.08, -0.25)
            double3 xformOp:scale = (0.42, 0.06, 0.08)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.11999999731779099, 0.14000000059604645, 0.1599999964237213)]
        }
    }
    def Xform "Suspension_FL" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (-0.95, -0.55, -1.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cylinder "Wheel_FL" (
            prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
            prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        )
        {
            double radius = 0.45
            double height = 0.28
            float physxVehicleWheel:radius = 0.44999998807907104
            float physxVehicleWheel:width = 0.2800000011920929
            float physxVehicleWheel:moi = 3.4000000953674316
            int physxVehicleWheelAttachment:index = 0
            float inputs:drive
            float inputs:drive.connect = </FLIP/Shaft_FL.outputs:torque>
            float inputs:steer
            float inputs:steer.connect = </FLIP.outputs:steering>
        }
    }
    def Xform "Suspension_FR" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
