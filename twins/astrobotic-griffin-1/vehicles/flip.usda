#usda 1.0
(
    defaultPrim = "FLIP"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "FLIP" (
    documentation = "Astrolab FLIP four-wheel lunar rover study proxy with finite EPS and Modelica drivetrain."
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "PhysxVehicleContextAPI", "PhysxVehicleTankDifferentialAPI", "LunCoCatalogAPI", "CollectionAPI:components"]
    prepend references = [@lunco://components/avionics/obc.usda@</OBC>, @lunco://components/cameras/rover_front_camera.usda@</RoverFrontCamera>, @lunco://components/mobility/drive_laws/modelica_skid.usda@</DriveLaw>]
    prepend variantSets = "drivetrain"
    variants = { string "drivetrain" = "raycast" }
)
{
    uniform bool lunco:spawnable = true
    custom string lunco:mission:payload = "Astrolab FLIP"
    custom string lunco:mission:vehicle_family = "FLEX Lunar Innovation Platform"
    custom string lunco:parameter_status = "public envelope plus explicit simulator assumptions"
    custom string lunco:provenance:source = "https://www.astrolab.space/flip-rover/"
    custom string lunco:provenance:video = "https://www.youtube.com/watch?v=UFEMOrg27KE"
    custom string lunco:provenance:engineering_boundary = "replace proxy values with FLIP as-built CAD and test data"
    float physics:mass = 450.0
    float3 physics:centerOfMass = (0.0, -0.05000000074505806, 0.0)
    float3 physics:diagonalInertia = (240.0, 337.5, 145.5)
    float physxRigidBody:linearDamping = 0.0
    float physxRigidBody:angularDamping = 2.0
    custom token lunco:steeringGeometry = "differential"
    float outputs:drive_left = 0.0
    float outputs:drive_right = 0.0
    float outputs:brake = 0.0
    uniform token collection:components:expansionRule = "explicitOnly"
    rel collection:components:includes
    prepend rel collection:components:includes = [</FLIP/Battery>, </FLIP/SolarArray>, </FLIP/Motor_FL>, </FLIP/TorqueSource_FL>, </FLIP/Gearbox_FL>, </FLIP/Shaft_FL>, </FLIP/Motor_FR>, </FLIP/TorqueSource_FR>, </FLIP/Gearbox_FR>, </FLIP/Shaft_FR>, </FLIP/Motor_RL>, </FLIP/TorqueSource_RL>, </FLIP/Gearbox_RL>, </FLIP/Shaft_RL>, </FLIP/Motor_RR>, </FLIP/TorqueSource_RR>, </FLIP/Gearbox_RR>, </FLIP/Shaft_RR>]
    float inputs:drive_left
    float inputs:drive_left.connect = </FLIP.outputs:drive_left>
    float inputs:drive_right
    float inputs:drive_right.connect = </FLIP.outputs:drive_right>
    float inputs:shaft_speed_FL
    float inputs:shaft_speed_FL.connect = </FLIP/Suspension_FL/Wheel_FL.outputs:shaft_speed>
    float inputs:shaft_speed_FR
    float inputs:shaft_speed_FR.connect = </FLIP/Suspension_FR/Wheel_FR.outputs:shaft_speed>
    float inputs:shaft_speed_RL
    float inputs:shaft_speed_RL.connect = </FLIP/Suspension_RL/Wheel_RL.outputs:shaft_speed>
    float inputs:shaft_speed_RR
    float inputs:shaft_speed_RR.connect = </FLIP/Suspension_RR/Wheel_RR.outputs:shaft_speed>
    float outputs:bus_voltage
    float outputs:bus_voltage.connect = </FLIP/Battery.outputs:terminal_voltage_v>
    float outputs:bus_current
    float outputs:bus_current.connect = </FLIP/Battery.outputs:terminal_current_a>
    float outputs:bus_power
    float outputs:bus_power.connect = </FLIP/Battery.outputs:net_power_w>
    float outputs:battery_soc
    float outputs:battery_soc.connect = </FLIP/Battery.outputs:soc_out>
    float outputs:battery_drained
    float outputs:battery_drained.connect = </FLIP/Battery.outputs:drained>
    custom double inputs:target_mount_x
    double inputs:target_mount_x.connect = </FLIP/SolarArray/Environment.outputs:sun_mount_x>
    custom double inputs:target_mount_y
    double inputs:target_mount_y.connect = </FLIP/SolarArray/Environment.outputs:sun_mount_y>
    custom double inputs:target_mount_z
    double inputs:target_mount_z.connect = </FLIP/SolarArray/Environment.outputs:sun_mount_z>
    string lunco:ui:surfaceId = "vessel-hud"
    string lunco:ui:visibilityMode = "possessed"
    bool physxRigidBody:enableCCD = true
    custom double inputs:irradiance
    double inputs:irradiance.connect = </FLIP/SolarArray/Environment.outputs:sun_irradiance_w_m2>
    custom double inputs:sun_visibility
    double inputs:sun_visibility.connect = </FLIP/SolarArray/Environment.outputs:sun_visibility>
    custom double inputs:solar_cell_temperature_k = 298.15 (
        documentation = "Prescribed cell temperature in K at the reference condition until a panel thermal network drives this boundary. This is not motor/chassis temperature or a flight-calibrated lunar cell temperature."
    )
    custom double outputs:solar_temperature_k
    double outputs:solar_temperature_k.connect = </FLIP/SolarArray.outputs:temperature_k>
    custom double outputs:solar_temperature_factor
    double outputs:solar_temperature_factor.connect = </FLIP/SolarArray.outputs:temperature_factor>
    custom double outputs:solar_heat_w
    double outputs:solar_heat_w.connect = </FLIP/SolarArray.outputs:heat_w>
    custom double outputs:solar_incident_power_w
    double outputs:solar_incident_power_w.connect = </FLIP/SolarArray.outputs:incident_power_w>
    custom double outputs:solar_reflected_power_w
    double outputs:solar_reflected_power_w.connect = </FLIP/SolarArray.outputs:reflected_power_w>
    custom double outputs:solar_temperature_adjusted_peak_power_w
    double outputs:solar_temperature_adjusted_peak_power_w.connect = </FLIP/SolarArray.outputs:temperature_adjusted_peak_power_w>
    custom double outputs:solar_available_power
    double outputs:solar_available_power.connect = </FLIP/SolarArray.outputs:available_power_w>
    custom double outputs:solar_power
    double outputs:solar_power.connect = </FLIP/SolarArray.outputs:power_out>
    variantSet "drivetrain" = {
        "raycast" {
        }
        "physical" (
            prepend references = @lunco://components/mobility/physical_drivetrain.usda@</Drivetrain>
        ) {
            over "Suspension_FL" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                over "Wheel_FL" (
                    prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                )
                {
                    custom rel physics:filteredPairs = [</FLIP/Chassis/LowerFrame>, </FLIP/Chassis/WhiteEquipmentBox>, </FLIP/Chassis/FrontBumper>, </FLIP/Chassis/PayloadDeck>]
                }
            }
            over "Suspension_FR" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                over "Wheel_FR" (
                    prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                )
                {
                    custom rel physics:filteredPairs = [</FLIP/Chassis/LowerFrame>, </FLIP/Chassis/WhiteEquipmentBox>, </FLIP/Chassis/FrontBumper>, </FLIP/Chassis/PayloadDeck>]
                }
            }
            over "Suspension_RL" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                over "Wheel_RL" (
                    prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                )
                {
                    custom rel physics:filteredPairs = [</FLIP/Chassis/LowerFrame>, </FLIP/Chassis/WhiteEquipmentBox>, </FLIP/Chassis/FrontBumper>, </FLIP/Chassis/PayloadDeck>]
                }
            }
            over "Suspension_RR" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                over "Wheel_RR" (
                    prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                )
                {
                    custom rel physics:filteredPairs = [</FLIP/Chassis/LowerFrame>, </FLIP/Chassis/WhiteEquipmentBox>, </FLIP/Chassis/FrontBumper>, </FLIP/Chassis/PayloadDeck>]
                }
            }
        }
    }
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</RoverControls>
    )
    {
    }
    def Xform "SensorMast" (
        references = @twin://astrobotic-griffin-1/components/rover/flip_sensor_mast_visual.usda@
    )
    {
        custom double3 xformOp:translate = (0.0, 0.46, -0.28)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Suspension_FL" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        custom double3 xformOp:translate = (0.65, -0.05, -1.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cylinder "Wheel_FL" (
            prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
            prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        )
        {
            double radius = 0.465
            double height = 0.28
            float physxVehicleWheel:radius = 0.4650000035762787
            float physxVehicleWheel:width = 0.2800000011920929
            float physxVehicleWheel:moi = 3.4000000953674316
            int physxVehicleWheelAttachment:index = 0
            float inputs:drive
            float inputs:drive.connect = </FLIP/Shaft_FL.outputs:torque>
            float lunco:suspension:restLength = 0.7649999856948853
            custom rel physics:filteredPairs = [</FLIP/Chassis/LowerFrame>, </FLIP/Chassis/WhiteEquipmentBox>, </FLIP/Chassis/FrontBumper>, </FLIP/Chassis/PayloadDeck>]
            uniform token purpose = "default"
            uniform token axis = "Z"
        }
        def Xform "Visual" (
            references = @twin://astrobotic-griffin-1/components/rover/flip_suspension_visual.usda@
        )
        {
            custom double3 xformOp:rotateXYZ = (0.0, -90.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }
