#usda 1.0
(
    defaultPrim = "FLIP"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "FLIP"
{
    def Xform "Visual" (
        prepend payload = @../visuals/FLIP_rover_v5.glb@
    )
    {
        string lunco:assetMode = "scene"
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 10000
        float inputs:angle = 0.53
        double3 xformOp:rotateXYZ = (-11, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Xform "Avatar"
    {
        string lunco:avatar = "true"
        string lunco:cameraMode = "freeflight"
        float lunco:cameraYaw = 0
        float lunco:cameraPitch = -0.2
        double3 xformOp:translate = (0, 2.2, 5.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}